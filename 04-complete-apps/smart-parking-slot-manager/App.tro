  PnlFooter.clProSettings.BorderColor = clAlphaColor.clHexToColor('#E2E8F0'); PnlFooter.clProSettings.BorderWidth = 1;
  PnlFooter.SetclProSettings(PnlFooter.clProSettings);
  
  BtnTabPark = MainForm.AddNewProButton(PnlFooter, 'BtnTabPark', 'OTOPARK');

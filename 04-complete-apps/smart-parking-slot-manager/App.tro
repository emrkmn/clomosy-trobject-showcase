  PnlParkView = MainForm.AddNewProPanel(PnlContent, 'PnlParkView');
  PnlParkView.Align = alClient; 
  PnlParkView.Margins.top = 5;
  PnlParkView.Margins.Left = 5;
  PnlParkView.Margins.Right = 5;
  PnlParkView.Margins.bottom = 5;

  PnlParkView.SetclProSettings(PnlParkView.clProSettings);
  
  PnlHistoryView = MainForm.AddNewProPanel(PnlContent, 'PnlHistoryView');
  PnlHistoryView.Align = alClient; 
  PnlHistoryView.Margins.top = 5;
  PnlHistoryView.Margins.Left = 5;
  PnlHistoryView.Margins.Right = 5;
  PnlHistoryView.Margins.bottom = 5;

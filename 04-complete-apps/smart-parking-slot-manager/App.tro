  LblCiroVal.clProSettings.FontHorzAlign = palTrailing;
  LblCiroVal.SetclProSettings(LblCiroVal.clProSettings);
  
  LblDoluStat = MainForm.AddNewProLabel(PnlStats, 'LblDoluStat', 'Dolu: 0');
  LblDoluStat.Align = alLeft; 
  LblDoluStat.Width = 80;
  LblDoluStat.clProSettings.FontColor = clAlphaColor.clHexToColor(Color_Red);
  LblDoluStat.clProSettings.FontSize = 14;
  LblDoluStat.SetclProSettings(LblDoluStat.clProSettings);
  
  LblBosStat = MainForm.AddNewProLabel(PnlStats, 'LblBosStat', 'Boş: 20');
  LblBosStat.Align = alLeft; 
  LblBosStat.Width = 80;
  LblBosStat.clProSettings.FontColor = clAlphaColor.clHexToColor(Color_Green);
  LblBosStat.clProSettings.FontSize = 14;
  LblBosStat.SetclProSettings(LblBosStat.clProSettings);

  PnlFooter = MainForm.AddNewProPanel(MainForm, 'PnlFooter');
  PnlFooter.Align = alBottom; 
  PnlFooter.Height = 60;
  PnlFooter.clProSettings.BackgroundColor = clAlphaColor.clHexToColor(Color_White);
  PnlFooter.clProSettings.IsFill = True;
  PnlFooter.clProSettings.BorderColor = clAlphaColor.clHexToColor('#E2E8F0'); 
  PnlFooter.clProSettings.BorderWidth = 1;
  PnlFooter.SetclProSettings(PnlFooter.clProSettings);
  
  BtnTabPark = MainForm.AddNewProButton(PnlFooter, 'BtnTabPark', 'OTOPARK');
  BtnTabPark.Align = alLeft; 
  BtnTabPark.Width = MainForm.clWidth div 2;
  BtnTabPark.clProSettings.BackgroundColor = clAlphaColor.clHexToColor(Color_White);
  BtnTabPark.clProSettings.FontColor = clAlphaColor.clHexToColor(Color_Blue);
  BtnTabPark.clProSettings.FontSize = 14;
  BtnTabPark.clProSettings.IsFill = True;
  BtnTabPark.SetclProSettings(BtnTabPark.clProSettings);
  MainForm.AddNewEvent(BtnTabPark, tbeOnClick, 'SwitchToPark');
  
  BtnTabHistory = MainForm.AddNewProButton(PnlFooter, 'BtnTabHistory', 'GEÇMİŞ');
  BtnTabHistory.Align = alClient;
  BtnTabHistory.clProSettings.BackgroundColor = clAlphaColor.clHexToColor(Color_White);
  BtnTabHistory.clProSettings.FontColor = clAlphaColor.clHexToColor('#94A3B8');
  BtnTabHistory.clProSettings.FontSize = 14;
  BtnTabHistory.clProSettings.IsFill = True;
  BtnTabHistory.SetclProSettings(BtnTabHistory.clProSettings);
  MainForm.AddNewEvent(BtnTabHistory, tbeOnClick, 'SwitchToHistory');

  PnlContent = MainForm.AddNewProPanel(MainForm, 'PnlContent');
  PnlContent.Align = alClient;
  PnlContent.clProSettings.BackgroundColor = clAlphaColor.clHexToColor(Color_Bg);
  PnlContent.clProSettings.IsFill = True;
  PnlContent.SetclProSettings(PnlContent.clProSettings);
  
  PnlParkView = MainForm.AddNewProPanel(PnlContent, 'PnlParkView');
  PnlParkView.Align = alClient; 
  PnlParkView.Margins.Top = 5;
  PnlParkView.Margins.Left = 5;
  PnlParkView.Margins.Right = 5;
  PnlParkView.Margins.Bottom = 5;
  PnlParkView.clProSettings.IsTransparent = True;
  PnlParkView.SetclProSettings(PnlParkView.clProSettings);
  
  PnlHistoryView = MainForm.AddNewProPanel(PnlContent, 'PnlHistoryView');
  PnlHistoryView.Align = alClient; 
  PnlHistoryView.Margins.Top = 5;
  PnlHistoryView.Margins.Left = 5;
  PnlHistoryView.Margins.Right = 5;
  PnlHistoryView.Margins.Bottom = 5;
  PnlHistoryView.clProSettings.IsTransparent = True; 
  PnlHistoryView.Visible = False;
  PnlHistoryView.SetclProSettings(PnlHistoryView.clProSettings);
  
  SwitchToPark;
  
  MainForm.Run;
}

{
  SetupDB;
  SetupUI;
}

var
  MainForm: TclForm;
  PnlHeader, PnlFooter: TclProPanel;
  PnlContent: TclProPanel; 
  PnlParkView, PnlHistoryView: TclProPanel;
  LblAppTitle, LblCiroVal: TclProLabel;
  PnlStats: TclProPanel;
  LblDoluStat, LblBosStat: TclProLabel;
  BtnTabPark, BtnTabHistory: TclProButton;
  PnlModalBack, PnlModalBox: TclProPanel;
  LblModalTitle, LblModalInfo: TclProLabel;
  EdtPlaka: TclProEdit;
  BtnModalOto, BtnModalKamyon, BtnModalCikis, BtnModalIptal: TclProButton;
  IslemTipi: String; 
  SeciliSlotID: Integer;
  HistoryScroll: TclVertScrollBox;
  QryPark, QryHistory: TclSQLiteQuery;
  GeciciPlaka, GeciciTipi, GeciciGirisStr: String;
  GeciciSure: Integer;
  GeciciUcret: Double;

const
  CAPACITY = 20; 
  UNIT_PRICE = 1.0; 
  MIN_FEE = 20.0;
  Color_Slate800 = '#1E293B';
  Color_Bg = '#F1F5F9';
  Color_White = '#FFFFFF';
  Color_Green = '#22C55E';
  Color_Red = '#EF4444';
  Color_Blue = '#3B82F6';
  Color_Orange = '#F97316';

void SetupDB;
var i: Integer;
{
  try
    Clomosy.DBSQLiteConnect(Clomosy.AppFilesPath + 'ModernParkV2.db', '');
    
    Clomosy.DBSQLiteQuery.Sql.Text = 'CREATE TABLE IF NOT EXISTS TBL_SLOTS (' +
      'SlotID INTEGER PRIMARY KEY, ' +
      'Plaka TEXT, ' +
      'AracTipi TEXT, ' +
      'GirisZamani TEXT, ' +
      'Status TEXT)'; 
    Clomosy.DBSQLiteQuery.OpenOrExecute;
    
    Clomosy.DBSQLiteQuery.Sql.Text = 'CREATE TABLE IF NOT EXISTS TBL_HISTORY (' +
      'ID INTEGER PRIMARY KEY AUTOINCREMENT, ' +
      'SlotID INTEGER, ' +
      'Plaka TEXT, ' +
      'AracTipi TEXT, ' +
      'GirisZamani TEXT, ' +
      'CikisZamani TEXT, ' +
      'Sure INTEGER, ' +
      'Ucret REAL)';
    Clomosy.DBSQLiteQuery.OpenOrExecute;
    
    QryPark = Clomosy.DBSQLiteQueryWith('SELECT COUNT(*) as Sayi FROM TBL_SLOTS');
    QryPark.OpenOrExecute;
    if (QryPark.FieldByName('Sayi').AsInteger == 0)
    {
      for i = 1 to CAPACITY
      {
        Clomosy.DBSQLiteQuery.Sql.Text = 'INSERT INTO TBL_SLOTS (SlotID, Status) VALUES ('+IntToStr(i)+', "EMPTY")';
        Clomosy.DBSQLiteQuery.OpenOrExecute;
      }
    }
  except
    ShowMessage('Veritabanı Hatası: ' + LastExceptionMessage);
  }
}

void UpdateStats;
var
  Dolu, Bos: Integer;
{
  try
    QryPark = Clomosy.DBSQLiteQueryWith('SELECT Status, COUNT(*) as Sayi FROM TBL_SLOTS GROUP BY Status');
    QryPark.OpenOrExecute;
    
    Dolu = 0; 
    Bos = CAPACITY; 
    
    while (not QryPark.Eof)
    {
      if (QryPark.FieldByName('Status').AsString == 'FULL') 
        Dolu = QryPark.FieldByName('Sayi').AsInteger;
      QryPark.Next;
    }
    Bos = CAPACITY - Dolu;
    
    LblDoluStat.Text = 'Dolu: ' + IntToStr(Dolu);
    LblBosStat.Text = 'Boş: ' + IntToStr(Bos);
    
    QryHistory = Clomosy.DBSQLiteQueryWith('SELECT SUM(CAST(Ucret AS REAL)) as Toplam FROM TBL_HISTORY');
    QryHistory.OpenOrExecute;
    
    if (QryHistory.FieldByName('Toplam').AsString == '') 
      LblCiroVal.Text = '0.00 ₺';
    else
      LblCiroVal.Text = FormatFloat('#,##0.00', QryHistory.FieldByName('Toplam').AsFloat) + ' ₺';
  except
  }
}

void RenderParkGrid;
var
  i, ColCount: Integer;
  BtnSlot: TclProButton;
  SlotStatus, PlakaTxt: String;
  GridScroll: TclVertScrollBox;
  BoxSize, Gap: Integer;
  Component: TclComponent; 
{
  Component = MainForm.clFindComponent('GridScroll');
  if (Component <> nil)
  {
    TclVertScrollBox(Component).Free;
  }
  
  GridScroll = MainForm.AddNewVertScrollBox(PnlParkView, 'GridScroll');
  GridScroll.Align = alClient;
  GridScroll.Margins.Top = 10;
  
  ColCount = 4;
  Gap = 5;
  BoxSize = (MainForm.clWidth - ((ColCount + 1) * Gap)) div ColCount;
  
  QryPark = Clomosy.DBSQLiteQueryWith('SELECT * FROM TBL_SLOTS ORDER BY SlotID ASC');
  QryPark.OpenOrExecute;
  
  for i = 1 to CAPACITY
  {
    SlotStatus = QryPark.FieldByName('Status').AsString;
    PlakaTxt = QryPark.FieldByName('Plaka').AsString;
    
    BtnSlot = MainForm.AddNewProButton(GridScroll, 'Slot_'+IntToStr(i), '');
    BtnSlot.Align = alNone;
    BtnSlot.Width = BoxSize;
    BtnSlot.Height = BoxSize;
    
    BtnSlot.Left = Gap + ((i-1) mod ColCount) * (BoxSize + Gap);
    BtnSlot.Top = Gap + ((i-1) div ColCount) * (BoxSize + Gap);
    
    BtnSlot.clProSettings.IsFill = True;
    BtnSlot.clProSettings.IsRound = True;
    BtnSlot.clProSettings.RoundWidth = 10; 
    BtnSlot.clProSettings.RoundHeight = 10;
    BtnSlot.clProSettings.BorderWidth = 2;
    BtnSlot.clProSettings.FontSize = 10;
    BtnSlot.clProSettings.FontVertAlign = palCenter;
    BtnSlot.clProSettings.FontHorzAlign = palCenter;
    BtnSlot.clProSettings.WordWrap = True;
    
    if (SlotStatus == 'EMPTY')
    {
      BtnSlot.Text = IntToStr(i) + #13#10 + 'BOŞ';
      BtnSlot.clProSettings.BackgroundColor = clAlphaColor.clWhite;
      BtnSlot.clProSettings.BorderColor = clAlphaColor.clHexToColor(Color_Green);
      BtnSlot.clProSettings.FontColor = clAlphaColor.clHexToColor(Color_Green);
    }
    else
    {
      BtnSlot.Text = IntToStr(i) + #13#10 + PlakaTxt;
      BtnSlot.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#FEF2F2'); 
      BtnSlot.clProSettings.BorderColor = clAlphaColor.clHexToColor(Color_Red);
      BtnSlot.clProSettings.FontColor = clAlphaColor.clHexToColor(Color_Red);
    }
    
    BtnSlot.SetclProSettings(BtnSlot.clProSettings);
    BtnSlot.clTagStr = IntToStr(i); 
    
    if (SlotStatus == 'FULL') BtnSlot.clTagInt = 1; else BtnSlot.clTagInt = 0;
    
    MainForm.AddNewEvent(BtnSlot, tbeOnClick, 'OnSlotClick');
    
    QryPark.Next;
  }
  
  UpdateStats;
}

void RenderHistory;
var
  PnlItem: TclProPanel;
  LblInfo, LblPrice: TclProLabel;
  IconView: TclProLabel; 
{
  if (HistoryScroll <> nil) HistoryScroll.Free;
  HistoryScroll = MainForm.AddNewVertScrollBox(PnlHistoryView, 'HistoryScroll');
  HistoryScroll.Align = alClient;
  HistoryScroll.Margins.Top = 10;
  
  QryHistory = Clomosy.DBSQLiteQueryWith('SELECT * FROM TBL_HISTORY ORDER BY ID DESC LIMIT 20');
  QryHistory.OpenOrExecute;
  
  if (QryHistory.Found)
  {
    while (not QryHistory.Eof)
    {
      PnlItem = MainForm.AddNewProPanel(HistoryScroll, 'Hist_'+QryHistory.FieldByName('ID').AsString);
      PnlItem.Align = alTop; 
      PnlItem.Height = 70;
      PnlItem.Margins.Left = 10; 
      PnlItem.Margins.Right = 10; 
      PnlItem.Margins.Bottom = 10;
      PnlItem.clProSettings.BackgroundColor = clAlphaColor.clWhite;
      PnlItem.clProSettings.IsFill = True;
      PnlItem.clProSettings.IsRound = True;
      PnlItem.clProSettings.RoundWidth = 10; 
      PnlItem.clProSettings.RoundHeight = 10;
      PnlItem.clProSettings.BorderColor = clAlphaColor.clHexToColor('#E2E8F0'); 
      PnlItem.clProSettings.BorderWidth = 1;
      PnlItem.SetclProSettings(PnlItem.clProSettings);
      
      IconView = MainForm.AddNewProLabel(PnlItem, 'Icon_'+QryHistory.FieldByName('ID').AsString, '');
      if (QryHistory.FieldByName('AracTipi').AsString == 'KAMYON') IconView.Text = '🚛';
      else IconView.Text = '🚗';
      IconView.Align = alLeft; 
      IconView.Width = 50;
      IconView.clProSettings.FontSize = 24; 
      IconView.clProSettings.FontHorzAlign = palCenter; 
      IconView.clProSettings.FontVertAlign = palCenter;
      IconView.SetclProSettings(IconView.clProSettings);
      
      LblInfo = MainForm.AddNewProLabel(PnlItem, 'Info_'+QryHistory.FieldByName('ID').AsString, 
        QryHistory.FieldByName('Plaka').AsString + #13#10 + 
        'Slot ' + QryHistory.FieldByName('SlotID').AsString + ' • ' + QryHistory.FieldByName('Sure').AsString + ' dk');
      LblInfo.Align = alClient; 
      LblInfo.Margins.Top = 15;
      LblInfo.clProSettings.FontSize = 12; 
      LblInfo.clProSettings.FontColor = clAlphaColor.clHexToColor('#000000');
      LblInfo.SetclProSettings(LblInfo.clProSettings);
      
      LblPrice = MainForm.AddNewProLabel(PnlItem, 'Price_'+QryHistory.FieldByName('ID').AsString, '+' + FormatFloat('0.00', QryHistory.FieldByName('Ucret').AsFloat) + ' ₺');
      LblPrice.Align = alRight; 
      LblPrice.Width = 90; 
      LblPrice.Margins.Right = 10;
      LblPrice.clProSettings.FontSize = 15; 
      LblPrice.clProSettings.FontColor = clAlphaColor.clHexToColor(Color_Green);
      LblPrice.clProSettings.FontHorzAlign = palTrailing; 
      LblPrice.clProSettings.FontVertAlign = palCenter;
      LblPrice.SetclProSettings(LblPrice.clProSettings);
      
      QryHistory.Next;
    }
  }
}

void HazirlaCikisBilgisi;
var
  SureDk, Carpan: Double;
{
  try
    // Süreyi cihazın bölgesel saat formatından bağımsız olarak doğrudan SQLite julianday ile hesaplıyoruz
    QryPark = Clomosy.DBSQLiteQueryWith(
      'SELECT Plaka, AracTipi, GirisZamani, ' +
      'CAST((julianday(''now'', ''localtime'') - julianday(GirisZamani)) * 1440 AS INTEGER) AS FarkDk ' +
      'FROM TBL_SLOTS WHERE SlotID = ' + IntToStr(SeciliSlotID)
    );
    QryPark.OpenOrExecute;
    
    if (QryPark.Found)
    {
      GeciciPlaka = QryPark.FieldByName('Plaka').AsString;
      GeciciTipi = QryPark.FieldByName('AracTipi').AsString;
      GeciciGirisStr = QryPark.FieldByName('GirisZamani').AsString;
      SureDk = QryPark.FieldByName('FarkDk').AsFloat;
      
      if (SureDk < 1) SureDk = 1;
      GeciciSure = Round(SureDk);
      
      if (GeciciTipi == 'KAMYON') Carpan = 2.0; else Carpan = 1.0;
      
      GeciciUcret = SureDk * UNIT_PRICE * Carpan;
      if (GeciciUcret < (MIN_FEE * Carpan)) GeciciUcret = MIN_FEE * Carpan;
      
      LblModalInfo.Text = 
        'Plaka: ' + GeciciPlaka + ' (' + GeciciTipi + ')' + #13#10 +
        'Süre: ' + IntToStr(GeciciSure) + ' Dakika' + #13#10 +
        'Ödenecek Tutar: ' + FormatFloat('#,##0.00', GeciciUcret) + ' ₺';
    }
  except
    ShowMessage('Hesaplama Hatası: ' + LastExceptionMessage);
  }
}

void OpenModal(Type: String);
{
  IslemTipi = Type;
  PnlModalBack.Visible = True;
  clRTMethod(PnlModalBack, 'BringToFront');
  
  if (Type == 'GIRIS')
  {
    LblModalTitle.Text = 'Araç Girişi - Slot ' + IntToStr(SeciliSlotID);
    LblModalInfo.Visible = False;
    EdtPlaka.Text = '';
    EdtPlaka.Visible = True;
    BtnModalOto.Visible = True;
    BtnModalKamyon.Visible = True;
    BtnModalCikis.Visible = False;
  }
  else 
  {
    LblModalTitle.Text = 'Araç Çıkışı - Slot ' + IntToStr(SeciliSlotID);
    HazirlaCikisBilgisi;
    LblModalInfo.Visible = True;
    EdtPlaka.Visible = False;
    BtnModalOto.Visible = False;
    BtnModalKamyon.Visible = False;
    BtnModalCikis.Visible = True;
  }
}

void CloseModal;
{
  PnlModalBack.Visible = False;
}

void OnSlotClick;
var Btn: TclProButton;
{
  Btn = TclProButton(MainForm.ClSender);
  SeciliSlotID = StrToInt(Btn.clTagStr);
  
  if (Btn.clTagInt == 0) OpenModal('GIRIS');
  else OpenModal('CIKIS');
}

void DoEntry(AracTipi: String);
{
  if (Trim(EdtPlaka.Text) == '') { ShowMessage('Plaka Giriniz!'); Exit; }
  
  try
    // SQLite standart tarih formatı (datetime('now', 'localtime')) ile kayıt
    Clomosy.DBSQLiteQuery.Sql.Text = 
      'UPDATE TBL_SLOTS SET Status="FULL", ' +
      'Plaka=' + QuotedStr(UpperCase(Trim(EdtPlaka.Text))) + ', ' +
      'AracTipi=' + QuotedStr(AracTipi) + ', ' +
      'GirisZamani=datetime(''now'', ''localtime'') ' +
      'WHERE SlotID=' + IntToStr(SeciliSlotID);
    Clomosy.DBSQLiteQuery.OpenOrExecute;
    
    CloseModal;
    RenderParkGrid;
    ShowMessage('Giriş Yapıldı: ' + UpperCase(Trim(EdtPlaka.Text)));
  except
    ShowMessage('Hata: ' + LastExceptionMessage);
  }
}

void OnBtnOtoClick; { DoEntry('OTO'); }
void OnBtnKamyonClick; { DoEntry('KAMYON'); }

void OnBtnCikisClick;
var
  UcretNoktali: String;
{
  try
    // DÜZELTME: 4. parametre olan rfReplaceAll kaldırıldı (3 parametre)
    UcretNoktali = clGetStringReplace(FormatFloat('0.00', GeciciUcret), ',', '.');

    Clomosy.DBSQLiteQuery.Sql.Text = 
      'INSERT INTO TBL_HISTORY (SlotID, Plaka, AracTipi, GirisZamani, CikisZamani, Sure, Ucret) VALUES (' +
      IntToStr(SeciliSlotID) + ',' +
      QuotedStr(GeciciPlaka) + ',' +
      QuotedStr(GeciciTipi) + ',' +
      QuotedStr(GeciciGirisStr) + ',' +
      'datetime(''now'', ''localtime''),' +
      IntToStr(GeciciSure) + ',' +
      UcretNoktali + ')';
    Clomosy.DBSQLiteQuery.OpenOrExecute;
    
    Clomosy.DBSQLiteQuery.Sql.Text = 
      'UPDATE TBL_SLOTS SET Status="EMPTY", Plaka="", AracTipi="", GirisZamani="" ' +
      'WHERE SlotID=' + IntToStr(SeciliSlotID);
    Clomosy.DBSQLiteQuery.OpenOrExecute;
    
    CloseModal;
    RenderParkGrid;
    ShowMessage('✅ Çıkış ve Tahsilat Tamamlandı (' + FormatFloat('#,##0.00', GeciciUcret) + ' ₺)');
  except
    ShowMessage('Çıkış Hatası: ' + LastExceptionMessage);
  }
}

void SwitchToPark;
{
  PnlParkView.Visible = True;
  PnlHistoryView.Visible = False;
  BtnTabPark.clProSettings.FontColor = clAlphaColor.clHexToColor(Color_Blue); 
  BtnTabPark.SetclProSettings(BtnTabPark.clProSettings);
  BtnTabHistory.clProSettings.FontColor = clAlphaColor.clHexToColor('#94A3B8'); 
  BtnTabHistory.SetclProSettings(BtnTabHistory.clProSettings);
  RenderParkGrid;
}

void SwitchToHistory;
{
  PnlParkView.Visible = False;
  PnlHistoryView.Visible = True;
  BtnTabHistory.clProSettings.FontColor = clAlphaColor.clHexToColor(Color_Blue); 
  BtnTabHistory.SetclProSettings(BtnTabHistory.clProSettings);
  BtnTabPark.clProSettings.FontColor = clAlphaColor.clHexToColor('#94A3B8'); 
  BtnTabPark.SetclProSettings(BtnTabPark.clProSettings);
  RenderHistory;
}


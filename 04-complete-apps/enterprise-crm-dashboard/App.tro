void SetCardStyle(APanel: TclProPanel);
{
  APanel.Align = alTop;
  APanel.Height = 76;
  APanel.Margins.Top = 6;
  APanel.Margins.Left = 14;
  APanel.Margins.Right = 14;
  APanel.Margins.Bottom = 2;
  APanel.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#FFFFFF');
  APanel.clProSettings.BorderColor = clAlphaColor.clHexToColor('#E2E8F0');
  APanel.clProSettings.BorderWidth = 1;
  APanel.clProSettings.IsRound = True;
  APanel.clProSettings.RoundHeight = 12;
  APanel.clProSettings.RoundWidth = 12;
  APanel.clProSettings.IsFill = True;
  APanel.SetclProSettings(APanel.clProSettings);
}

void SetEditStyle(AEdit: TclProEdit);
{
  AEdit.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F8FAFC');
  AEdit.clProSettings.BorderColor = clAlphaColor.clHexToColor('#CBD5E1');
  AEdit.clProSettings.BorderWidth = 1;
  AEdit.clProSettings.FontColor = clAlphaColor.clHexToColor('#0F172A');
  AEdit.clProSettings.FontSize = 11;
  AEdit.clProSettings.IsRound = True;
  AEdit.clProSettings.RoundHeight = 8;
  AEdit.clProSettings.RoundWidth = 8;
  AEdit.clProSettings.IsFill = True;
  AEdit.SetclProSettings(AEdit.clProSettings);
}

void SetStatusPill(APanel: TclProPanel; ALbl: TclProLabel; AState: Integer);
var
  BgCol, FgCol, StatusText: String;
{
  if (AState == 0)
  {
    StatusText = 'Fırsat';
    BgCol = '#FEF3C7';
    FgCol = '#D97706';
  }
  else if (AState == 1)
  {
    StatusText = 'Görüşme';
    BgCol = '#E0F2FE';
    FgCol = '#0284C7';
  }
  else if (AState == 2)
  {
    StatusText = 'Teklif';
    BgCol = '#F3E8FF';
    FgCol = '#7C3AED';
  }
  else
  {
    StatusText = 'Kazanıldı';
    BgCol = '#D1FAE5';
    FgCol = '#059669';
  }

  APanel.clProSettings.BackgroundColor = clAlphaColor.clHexToColor(BgCol);
  APanel.clProSettings.BorderColor = clAlphaColor.clHexToColor(FgCol);
  APanel.clProSettings.BorderWidth = 1;
  APanel.SetclProSettings(APanel.clProSettings);

  ALbl.Text = StatusText;
  ALbl.clProSettings.FontColor = clAlphaColor.clHexToColor(FgCol);
  ALbl.SetclProSettings(ALbl.clProSettings);
}

void SetBarStyle(APanel: TclProPanel; AHeight: Integer; AColor: String);
{
  APanel.Align = alBottom;
  APanel.Width = 22;
  APanel.Height = AHeight;
  APanel.Margins.Left = 8;
  APanel.Margins.Right = 8;
  APanel.clProSettings.BackgroundColor = clAlphaColor.clHexToColor(AColor);
  APanel.clProSettings.IsRound = True;
  APanel.clProSettings.RoundHeight = 6;
  APanel.clProSettings.RoundWidth = 6;
  APanel.clProSettings.IsFill = True;
  APanel.SetclProSettings(APanel.clProSettings);
}

void SetMonthLabelStyle(ALbl: TclProLabel; AText: String);
{
  ALbl.Align = alBottom;
  ALbl.Height = 18;
  ALbl.Text = AText;
  ALbl.clProSettings.FontSize = 9;
  ALbl.clProSettings.FontColor = clAlphaColor.clHexToColor('#94A3B8');
  ALbl.clProSettings.FontHorzAlign = palCenter;
  ALbl.clProSettings.TextSettings.Font.Style = [fsBold];
  ALbl.SetclProSettings(ALbl.clProSettings);
}

void VeritabaniHazirla;
{
  try
    Clomosy.DBSQLiteConnect(Clomosy.AppFilesPath + 'crm.db3', '');
    Clomosy.DBSQLiteQuery.Sql.Text = 'CREATE TABLE IF NOT EXISTS customers (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, company TEXT, phone TEXT, email TEXT, industry TEXT, value REAL, state INTEGER, created_at TEXT);';
    Clomosy.DBSQLiteQuery.OpenOrExecute;

    try
      Clomosy.DBSQLiteQuery.Sql.Text = 'ALTER TABLE customers ADD COLUMN industry TEXT';
      Clomosy.DBSQLiteQuery.OpenOrExecute;
    except
    }

    try
      Clomosy.DBSQLiteQuery.Sql.Text = 'ALTER TABLE customers ADD COLUMN value REAL DEFAULT 0';
      Clomosy.DBSQLiteQuery.OpenOrExecute;
    except
    }

    try
      Clomosy.DBSQLiteQuery.Sql.Text = 'ALTER TABLE customers ADD COLUMN created_at TEXT';
      Clomosy.DBSQLiteQuery.OpenOrExecute;
    except
    }
  except
    ShowMessage('Veritabanı Hatası: ' + LastExceptionMessage);
  }
}

// --- DİNAMİK AYLIK GRAFİK ÇİZİCİ ---
void GuncelleGrafik;
var
  QryG: TClSQLiteQuery;
  TotalVal: Double;
  H1, H2, H3, H4, H5, H6: Integer;
{
  H1 = 30; H2 = 55; H3 = 45; H4 = 80; H5 = 65; H6 = 90;

  try
    QryG = Clomosy.DBSQLiteQueryWith('SELECT SUM(value) as val FROM customers WHERE state = 3');
    QryG.OpenOrExecute;
    if (QryG.Found)
    {
      TotalVal = QryG.FieldByName('val').AsFloat;
      if (TotalVal > 0)
      {
        H6 = 40 + Trunc((TotalVal / 20000));
        if (H6 > 145)
          H6 = 145;
        if (H6 < 40)
          H6 = 40;
      }
    }
  except
  }

  SetBarStyle(PnlBar1, H1, '#2563EB');
  SetBarStyle(PnlBar2, H2, '#10B981');
  SetBarStyle(PnlBar3, H3, '#2563EB');
  SetBarStyle(PnlBar4, H4, '#10B981');
  SetBarStyle(PnlBar5, H5, '#2563EB');
  SetBarStyle(PnlBar6, H6, '#10B981');
}

// --- DİNAMİK SON AKTİVİTELER LİSTESİ ---
void GuncelleAktiviteler;
var
  QryA: TClSQLiteQuery;
  PnlItem, PnlIconBg, PnlTexts: TclProPanel;
  LblIcon, LblTtl, LblSubt, LblTm: TclProLabel;
  CustName, CustComp, DurumStr, IconStr, IconBgHex, ValStr: String;
  CustState, CustId: Integer;
  CustVal: Double;
{
  ActSurum = ActSurum + 1;

  try
    if (SbActivities <> nil)
    {
      SbActivities.Free;
    }
  except
  }

  SbActivities = AnaForm.AddNewVertScrollBox(PnlActivityCard, 'SbActivities_' + IntToStr(ActSurum));
  SbActivities.Align = alClient;
  SbActivities.Margins.Left = 14;
  SbActivities.Margins.Right = 14;
  SbActivities.Margins.Bottom = 8;

  try
    QryA = Clomosy.DBSQLiteQueryWith('SELECT id, name, company, value, state, industry FROM customers ORDER BY id DESC LIMIT 10');
    QryA.OpenOrExecute;

    if (QryA.Found)
    {
      while (not QryA.EOF)
      {
        CustId = QryA.FieldByName('id').AsInteger;
        CustName = QryA.FieldByName('name').AsString;
        CustComp = QryA.FieldByName('company').AsString;
        CustVal = QryA.FieldByName('value').AsFloat;
        CustState = QryA.FieldByName('state').AsInteger;

        ValStr = '₺' + FormatFloat('#,##0', CustVal);

        if (CustState == 3)
        {
          DurumStr = 'Teklif onaylandı (' + ValStr + ')';
          IconStr = '✓';
          IconBgHex = '#E6F4EA';
        }
        else if (CustState == 2)
        {
          DurumStr = 'Teklif hazırlandı (' + ValStr + ')';
          IconStr = '📄';
          IconBgHex = '#FEF3C7';
        }
        else if (CustState == 1)
        {
          DurumStr = 'Görüşme planlandı';
          IconStr = '💬';
          IconBgHex = '#EFF6FF';
        }
        else
        {
          DurumStr = 'Yeni fırsat eklendi (' + ValStr + ')';
          IconStr = '👤';
          IconBgHex = '#F1F5F9';
        }

        PnlItem = AnaForm.AddNewProPanel(SbActivities, 'PnlActItem_' + IntToStr(ActSurum) + '_' + IntToStr(CustId));
        PnlItem.Align = alTop;
        PnlItem.Height = 54;
        PnlItem.Margins.Top = 4;
        PnlItem.clProSettings.IsFill = False;
        PnlItem.SetclProSettings(PnlItem.clProSettings);

        PnlIconBg = AnaForm.AddNewProPanel(PnlItem, 'PnlActIconBg_' + IntToStr(ActSurum) + '_' + IntToStr(CustId));
        PnlIconBg.Align = alLeft;
        PnlIconBg.Width = 34;
        PnlIconBg.Height = 34;
        PnlIconBg.Margins.Top = 8;
        PnlIconBg.Margins.Bottom = 8;
        PnlIconBg.Margins.Left = 6;
        PnlIconBg.clProSettings.BackgroundColor = clAlphaColor.clHexToColor(IconBgHex);
        PnlIconBg.clProSettings.IsRound = True;
        PnlIconBg.clProSettings.RoundHeight = 17;
        PnlIconBg.clProSettings.RoundWidth = 17;
        PnlIconBg.clProSettings.IsFill = True;
        PnlIconBg.SetclProSettings(PnlIconBg.clProSettings);

        LblIcon = AnaForm.AddNewProLabel(PnlIconBg, 'LblActIcon_' + IntToStr(ActSurum) + '_' + IntToStr(CustId), IconStr);
        LblIcon.Align = alClient;
        LblIcon.clProSettings.FontSize = 11;
        LblIcon.clProSettings.FontHorzAlign = palCenter;
        LblIcon.clProSettings.FontVertAlign = palCenter;
        LblIcon.SetclProSettings(LblIcon.clProSettings);

        PnlTexts = AnaForm.AddNewProPanel(PnlItem, 'PnlActTexts_' + IntToStr(ActSurum) + '_' + IntToStr(CustId));
        PnlTexts.Align = alClient;
        PnlTexts.clProSettings.IsFill = False;
        PnlTexts.SetclProSettings(PnlTexts.clProSettings);

        LblTtl = AnaForm.AddNewProLabel(PnlTexts, 'LblActTtl_' + IntToStr(ActSurum) + '_' + IntToStr(CustId), DurumStr);
        LblTtl.Align = alTop;
        LblTtl.Height = 18;
        LblTtl.Margins.Left = 10;
        LblTtl.Margins.Top = 4;
        LblTtl.clProSettings.FontSize = 11;
        LblTtl.clProSettings.FontColor = clAlphaColor.clHexToColor('#1E293B');
        LblTtl.clProSettings.TextSettings.Font.Style = [fsBold];
        LblTtl.SetclProSettings(LblTtl.clProSettings);

        LblSubt = AnaForm.AddNewProLabel(PnlTexts, 'LblActSubt_' + IntToStr(ActSurum) + '_' + IntToStr(CustId), CustName + ' (' + CustComp + ')');
        LblSubt.Align = alTop;
        LblSubt.Height = 16;
        LblSubt.Margins.Left = 10;
        LblSubt.clProSettings.FontSize = 9;
        LblSubt.clProSettings.FontColor = clAlphaColor.clHexToColor('#64748B');
        LblSubt.SetclProSettings(LblSubt.clProSettings);

        LblTm = AnaForm.AddNewProLabel(PnlTexts, 'LblActTm_' + IntToStr(ActSurum) + '_' + IntToStr(CustId), 'Güncel');
        LblTm.Align = alBottom;
        LblTm.Height = 14;
        LblTm.Margins.Left = 10;
        LblTm.Margins.Bottom = 2;
        LblTm.clProSettings.FontSize = 8;
        LblTm.clProSettings.FontColor = clAlphaColor.clHexToColor('#94A3B8');
        LblTm.SetclProSettings(LblTm.clProSettings);

        QryA.Next;
      }
    }
  except
  }
}

void GuncelleIstatistik;
var
  Qry: TClSQLiteQuery;
  TotalCount, WonCount, ActiveCount, WinRate, QuotesCount: Integer;
  TotalVolume, WonVolume, ActiveVolume: Double;
{
  TotalCount = 0;
  WonCount = 0;
  ActiveCount = 0;
  QuotesCount = 0;
  TotalVolume = 0;
  WonVolume = 0;
  ActiveVolume = 0;
  WinRate = 0;

  try
    Qry = Clomosy.DBSQLiteQueryWith('SELECT state, COUNT(*) as cnt, COALESCE(SUM(value), 0) as val FROM customers GROUP BY state');
    Qry.OpenOrExecute;
    
    if (Qry.Found)
    {
      while (not Qry.EOF)
      {
        TotalCount = TotalCount + Qry.FieldByName('cnt').AsInteger;
        TotalVolume = TotalVolume + Qry.FieldByName('val').AsFloat;

        if (Qry.FieldByName('state').AsInteger == 3)
        {
          WonCount = WonCount + Qry.FieldByName('cnt').AsInteger;
          WonVolume = WonVolume + Qry.FieldByName('val').AsFloat;
        }
        else if (Qry.FieldByName('state').AsInteger == 2)
        {
          QuotesCount = QuotesCount + Qry.FieldByName('cnt').AsInteger;
        }
        else
        {
          ActiveCount = ActiveCount + Qry.FieldByName('cnt').AsInteger;
          ActiveVolume = ActiveVolume + Qry.FieldByName('val').AsFloat;
        }
        Qry.Next;
      }
    }
  except
  }

  if (TotalCount > 0)
  {
    WinRate = Trunc((WonCount * 100) / TotalCount);
  }

  LblKpi1Val.Text = '₺' + FormatFloat('#,##0', TotalVolume);
  LblKpi2Val.Text = IntToStr(ActiveCount) + ' Fırsat';
  LblKpi2Trend.Text = '₺' + FormatFloat('#,##0', ActiveVolume);
  LblKpi3Val.Text = IntToStr(QuotesCount) + ' Adet';
  LblKpi4Val.Text = '%' + IntToStr(WinRate);

  BtnTabFirsat.Text = '💼 Fırsatlar ' + IntToStr(ActiveCount);
  BtnTabTeklif.Text = '📄 Teklifler ' + IntToStr(QuotesCount);
  BtnTabMusteri.Text = '👥 Müşteriler ' + IntToStr(TotalCount);

  GuncelleGrafik;
  GuncelleAktiviteler;
}

void OnCallClick;
var
  CustId: Integer;
  QryTel: TClSQLiteQuery;
  PhoneStr: String;
{
  CustId = TclProButton(AnaForm.ClSender).ClTagInt;
  try
    QryTel = Clomosy.DBSQLiteQueryWith('SELECT phone FROM customers WHERE id = ' + IntToStr(CustId));
    QryTel.OpenOrExecute;
    if (QryTel.Found)
    {
      PhoneStr = Trim(QryTel.FieldByName('phone').AsString);
      if (PhoneStr <> '')
      {
        TClomosyOS.Dial(PhoneStr);
      }
    }
  except
  }
}

void OnWAClick;
var
  CustId: Integer;
  QryWA: TClSQLiteQuery;
  PhoneStr: String;
{
  CustId = TclProButton(AnaForm.ClSender).ClTagInt;
  try
    QryWA = Clomosy.DBSQLiteQueryWith('SELECT phone FROM customers WHERE id = ' + IntToStr(CustId));
    QryWA.OpenOrExecute;
    if (QryWA.Found)
    {
      PhoneStr = Trim(QryWA.FieldByName('phone').AsString);
      if (PhoneStr <> '')
      {
        TClomosyOS.OpenURL('https://wa.me/90' + PhoneStr);
      }
    }
  except
  }
}

void OnMailClick;
var
  CustId: Integer;
  QryMail: TClSQLiteQuery;
  EmailStr, CustNameStr: String;
{
  CustId = TclProButton(AnaForm.ClSender).ClTagInt;
  try
    QryMail = Clomosy.DBSQLiteQueryWith('SELECT name, email FROM customers WHERE id = ' + IntToStr(CustId));
    QryMail.OpenOrExecute;
    if (QryMail.Found)
    {
      EmailStr = Trim(QryMail.FieldByName('email').AsString);
      CustNameStr = Trim(QryMail.FieldByName('name').AsString);
      if (EmailStr <> '')
      {
        TClomosyOS.OpenEmail(EmailStr, 'Clomosy App - ' + CustNameStr + ' Bilgilendirme', 'Merhaba ' + CustNameStr + ',');
      }
    }
  except
  }
}

void ListeleMusteriler;
var
  Qry: TClSQLiteQuery;
  IDStr, QueryStr, IdEk, CustName, CustChar, IndStr: String;
  ValNum: Double;
  PnlCard, PnlCardHead, PnlAvatar, PnlLeft, PnlRightWrap, PnlStatus, PnlDetail, PnlCommRow, PnlSel, PnlRow1, PnlRow2: TclProPanel;
  LblAvatar, LblName, LblCompany, LblValue, LblStatus, LblPhone, LblEmail: TclProLabel;
  BtnCall, BtnWA, BtnMail, BtnSetF, BtnSetG, BtnSetT, BtnSetK, BtnDelete: TclProButton;
  ItemBtnWidth, CommBtnWidth: Single;
{
  RenderSurum = RenderSurum + 1;

  try
    if (SbCustomers <> nil)
    {
      SbCustomers.Free;
    }
  except
  }

  SbCustomers = AnaForm.AddNewVertScrollBox(PnlScrollTasiyici, 'SbCustomers_' + IntToStr(RenderSurum));
  SbCustomers.Align = alClient;

  QueryStr = 'SELECT * FROM customers WHERE 1=1';
  
  if (SearchKeyword <> '')
  {
    QueryStr = QueryStr + ' AND (name LIKE ''%' + SearchKeyword + '%'' OR company LIKE ''%' + SearchKeyword + '%'' OR phone LIKE ''%' + SearchKeyword + '%'' OR industry LIKE ''%' + SearchKeyword + '%'')';
  }

  if (ActiveFilter == 1)
  {
    QueryStr = QueryStr + ' AND (state = 0 OR state = 1)';
  }
  else if (ActiveFilter == 2)
  {
    QueryStr = QueryStr + ' AND state = 2';
  }
  else if (ActiveFilter == 3)
  {
    QueryStr = QueryStr + ' AND state = 3';
  }

  QueryStr = QueryStr + ' ORDER BY id DESC';

  try
    Qry = Clomosy.DBSQLiteQueryWith(QueryStr);
    Qry.OpenOrExecute;

    if (Qry.Found)
    {
      while (not Qry.EOF)
      {
        IDStr = Qry.FieldByName('id').AsString;
        CustName = Qry.FieldByName('name').AsString;
        
        try
          IndStr = Qry.FieldByName('industry').AsString;
        except
          IndStr = 'Genel';
        }

        try
          ValNum = Qry.FieldByName('value').AsFloat;
        except
          ValNum = 0;
        }

        IdEk = '_' + IntToStr(RenderSurum) + '_' + IDStr;

        CustChar = 'M';
        if (Length(Trim(CustName)) > 0)
        {
          CustChar = UpperCase(Copy(Trim(CustName), 1, 1));
        }

        if (IndStr == '')
        {
          IndStr = 'Genel';
        }

        PnlCard = AnaForm.AddNewProPanel(SbCustomers, 'PnlCard' + IdEk);
        SetCardStyle(PnlCard);
        PnlCard.Height = 76;

        PnlCardHead = AnaForm.AddNewProPanel(PnlCard, 'PnlHead' + IdEk);
        PnlCardHead.Align = alTop;
        PnlCardHead.Height = 76;
        PnlCardHead.ClTagInt = StrToInt(IDStr);
        PnlCardHead.clProSettings.IsFill = False;
        PnlCardHead.SetclProSettings(PnlCardHead.clProSettings);
        AnaForm.AddNewEvent(PnlCardHead, tbeOnClick, 'OnCardClick');

        PnlAvatar = AnaForm.AddNewProPanel(PnlCardHead, 'PnlAvatar' + IdEk);
        PnlAvatar.Align = alLeft;
        PnlAvatar.Width = 42;
        PnlAvatar.Height = 42;
        PnlAvatar.Margins.Left = 10;
        PnlAvatar.Margins.Top = 17;
        PnlAvatar.Margins.Bottom = 17;
        PnlAvatar.ClTagInt = StrToInt(IDStr);
        PnlAvatar.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#EFF6FF');
        PnlAvatar.clProSettings.BorderColor = clAlphaColor.clHexToColor('#DBEAFE');
        PnlAvatar.clProSettings.BorderWidth = 1;
        PnlAvatar.clProSettings.IsRound = True;
        PnlAvatar.clProSettings.RoundHeight = 21;
        PnlAvatar.clProSettings.RoundWidth = 21;
        PnlAvatar.clProSettings.IsFill = True;
        PnlAvatar.SetclProSettings(PnlAvatar.clProSettings);
        AnaForm.AddNewEvent(PnlAvatar, tbeOnClick, 'OnCardClick');

        LblAvatar = AnaForm.AddNewProLabel(PnlAvatar, 'LblAvatar' + IdEk, CustChar);
        LblAvatar.Align = alClient;
        LblAvatar.ClTagInt = StrToInt(IDStr);
        LblAvatar.clProSettings.FontSize = 15;
        LblAvatar.clProSettings.FontColor = clAlphaColor.clHexToColor('#2563EB');
        LblAvatar.clProSettings.FontHorzAlign = palCenter;
        LblAvatar.clProSettings.FontVertAlign = palCenter;
        LblAvatar.clProSettings.TextSettings.Font.Style = [fsBold];
        LblAvatar.SetclProSettings(LblAvatar.clProSettings);
        AnaForm.AddNewEvent(LblAvatar, tbeOnClick, 'OnCardClick');

        PnlRightWrap = AnaForm.AddNewProPanel(PnlCardHead, 'PnlRightWrap' + IdEk);
        PnlRightWrap.Align = alRight;
        PnlRightWrap.Width = 85;
        PnlRightWrap.Margins.Right = 10;
        PnlRightWrap.ClTagInt = StrToInt(IDStr);
        PnlRightWrap.clProSettings.IsFill = False;

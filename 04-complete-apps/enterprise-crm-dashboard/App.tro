void OnCardClick;
var
  TiklananBilesen: TclProPanel;
  CustId: Integer;
  IdEk: String;
  PnlCard, PnlDetail: TclProPanel;
{
  TiklananBilesen = TclProPanel(AnaForm.ClSender);
  CustId = TiklananBilesen.ClTagInt;
  IdEk = '_' + IntToStr(RenderSurum) + '_' + IntToStr(CustId);

  PnlCard = TclProPanel(AnaForm.clFindComponent('PnlCard' + IdEk));
  PnlDetail = TclProPanel(AnaForm.clFindComponent('PnlDetail' + IdEk));

  if ((PnlCard <> nil) && (PnlDetail <> nil))
  {
    if (not PnlDetail.Visible)
    {
      PnlCard.Height = 265;
      PnlDetail.Visible = True;
    }
    else
    {
      PnlDetail.Visible = False;
      PnlCard.Height = 76;
    }
  }
}

void DurumGuncelle(CustId, NewState: Integer);
var
  IdEk: String;
  PnlStatus: TclProPanel;
  LblStatus: TclProLabel;
{
  try
    Clomosy.DBSQLiteQuery.Sql.Text = 'UPDATE customers SET state = ' + IntToStr(NewState) + ' WHERE id = ' + IntToStr(CustId);
    Clomosy.DBSQLiteQuery.OpenOrExecute;

    IdEk = '_' + IntToStr(RenderSurum) + '_' + IntToStr(CustId);
    PnlStatus = TclProPanel(AnaForm.clFindComponent('PnlStatus' + IdEk));
    LblStatus = TclProLabel(AnaForm.clFindComponent('LblStatus' + IdEk));
    
    if ((PnlStatus <> nil) && (LblStatus <> nil))
    {
      SetStatusPill(PnlStatus, LblStatus, NewState);
    }

    GuncelleIstatistik;
  except
    ShowMessage('Güncelleme Hatası: ' + LastExceptionMessage);
  }
}

void OnSetFClick; { DurumGuncelle(TclProButton(AnaForm.ClSender).ClTagInt, 0); }
void OnSetGClick; { DurumGuncelle(TclProButton(AnaForm.ClSender).ClTagInt, 1); }
void OnSetTClick; { DurumGuncelle(TclProButton(AnaForm.ClSender).ClTagInt, 2); }
void OnSetKClick; { DurumGuncelle(TclProButton(AnaForm.ClSender).ClTagInt, 3); }

void OnDeleteClick;
var
  CustId: Integer;
{
  CustId = TclProButton(AnaForm.ClSender).ClTagInt;
  try
    Clomosy.DBSQLiteQuery.Sql.Text = 'DELETE FROM customers WHERE id = ' + IntToStr(CustId);
    Clomosy.DBSQLiteQuery.OpenOrExecute;

    ListeleMusteriler;
  except
    ShowMessage('Silme Hatası: ' + LastExceptionMessage);
  }
}

void UpdateModalStateUI;
{
  BtnMState0.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F8FAFC');
  BtnMState0.clProSettings.BorderColor = clAlphaColor.clHexToColor('#CBD5E1');
  BtnMState0.clProSettings.FontColor = clAlphaColor.clHexToColor('#64748B');
  BtnMState0.SetclProSettings(BtnMState0.clProSettings);

  BtnMState1.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F8FAFC');
  BtnMState1.clProSettings.BorderColor = clAlphaColor.clHexToColor('#CBD5E1');
  BtnMState1.clProSettings.FontColor = clAlphaColor.clHexToColor('#64748B');
  BtnMState1.SetclProSettings(BtnMState1.clProSettings);

  BtnMState2.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F8FAFC');
  BtnMState2.clProSettings.BorderColor = clAlphaColor.clHexToColor('#CBD5E1');
  BtnMState2.clProSettings.FontColor = clAlphaColor.clHexToColor('#64748B');
  BtnMState2.SetclProSettings(BtnMState2.clProSettings);

  BtnMState3.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F8FAFC');
  BtnMState3.clProSettings.BorderColor = clAlphaColor.clHexToColor('#CBD5E1');
  BtnMState3.clProSettings.FontColor = clAlphaColor.clHexToColor('#64748B');
  BtnMState3.SetclProSettings(BtnMState3.clProSettings);

  if (SelectedNewState == 0)
  {
    BtnMState0.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#FEF3C7');
    BtnMState0.clProSettings.BorderColor = clAlphaColor.clHexToColor('#D97706');
    BtnMState0.clProSettings.FontColor = clAlphaColor.clHexToColor('#D97706');
    BtnMState0.SetclProSettings(BtnMState0.clProSettings);
  }
  else if (SelectedNewState == 1)
  {
    BtnMState1.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#E0F2FE');
    BtnMState1.clProSettings.BorderColor = clAlphaColor.clHexToColor('#0284C7');
    BtnMState1.clProSettings.FontColor = clAlphaColor.clHexToColor('#0284C7');
    BtnMState1.SetclProSettings(BtnMState1.clProSettings);
  }
  else if (SelectedNewState == 2)
  {
    BtnMState2.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F3E8FF');
    BtnMState2.clProSettings.BorderColor = clAlphaColor.clHexToColor('#7C3AED');
    BtnMState2.clProSettings.FontColor = clAlphaColor.clHexToColor('#7C3AED');
    BtnMState2.SetclProSettings(BtnMState2.clProSettings);
  }
  else if (SelectedNewState == 3)
  {
    BtnMState3.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#D1FAE5');
    BtnMState3.clProSettings.BorderColor = clAlphaColor.clHexToColor('#059669');
    BtnMState3.clProSettings.FontColor = clAlphaColor.clHexToColor('#059669');
    BtnMState3.SetclProSettings(BtnMState3.clProSettings);
  }
}

void OnMState0Click; { SelectedNewState = 0; UpdateModalStateUI; }
void OnMState1Click; { SelectedNewState = 1; UpdateModalStateUI; }
void OnMState2Click; { SelectedNewState = 2; UpdateModalStateUI; }
void OnMState3Click; { SelectedNewState = 3; UpdateModalStateUI; }

void OpenModal;
{
  EdtNewName.Text = '';
  EdtNewCompany.Text = '';
  EdtNewPhone.Text = '';
  EdtNewEmail.Text = '';
  EdtNewIndustry.Text = '';
  EdtNewValue.Text = '';
  SelectedNewState = 0;
  UpdateModalStateUI;

  PnlMainPage.HitTest = False;
  PnlModalOverlay.Visible = True;
  PnlModalOverlay.BringToFront;
}

void CloseModal;
{
  PnlModalOverlay.Visible = False;
  PnlMainPage.HitTest = True;
}

void OnOverlayClick;
{
  CloseModal;
}

void SaveNewCustomer;
var
  AName, AComp, APhone, AEmail, AInd, AValStr: String;
  AVal: Double;
{
  AName = Trim(EdtNewName.Text);
  AComp = Trim(EdtNewCompany.Text);
  APhone = Trim(EdtNewPhone.Text);
  AEmail = Trim(EdtNewEmail.Text);
  AInd = Trim(EdtNewIndustry.Text);
  AValStr = Trim(EdtNewValue.Text);

  if (AName == '')
  {
    ShowMessage('Lütfen müşteri adını giriniz!');
    Exit;
  }

  if (AComp == '')
  {
    ShowMessage('Lütfen şirket adını giriniz!');
    Exit;
  }

  if (AInd == '')
  {
    AInd = 'Teknoloji';
  }

  AVal = 0;
  if (AValStr <> '')
  {
    try
      AVal = StrToFloat(AValStr);
    except
      AVal = 0;
    }
  }

  try
    Clomosy.DBSQLiteQuery.Sql.Text = 'INSERT INTO customers (name, company, phone, email, industry, value, state, created_at) VALUES (' +
                                     QuotedStr(AName) + ', ' +
                                     QuotedStr(AComp) + ', ' +
                                     QuotedStr(APhone) + ', ' +
                                     QuotedStr(AEmail) + ', ' +
                                     QuotedStr(AInd) + ', ' +
                                     FloatToStr(AVal) + ', ' +
                                     IntToStr(SelectedNewState) + ', ''2026-08-19'');';
    Clomosy.DBSQLiteQuery.OpenOrExecute;

    CloseModal;
    ListeleMusteriler;
    GuncelleIstatistik;
  except
    ShowMessage('Kayıt Hatası: ' + LastExceptionMessage);
  }
}

void OnSearchChange;
{
  SearchKeyword = Trim(EdtSearch.Text);
  ListeleMusteriler;
}

void OnSearchHeaderChange;
{
  SearchKeyword = Trim(EdtSearchHeader.Text);
  EdtSearch.Text = SearchKeyword;
  ListeleMusteriler;
}

void TabGecisleri(Secim: Integer);
{
  BtnTabAll.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
  BtnTabFirsat.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
  BtnTabTeklif.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
  BtnTabMusteri.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
  BtnTabGorevler.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
  BtnTabAnalizler.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');

  BtnTabAll.clProSettings.BorderColor = clAlphaColor.clHexToColor('#FFFFFF');
  BtnTabFirsat.clProSettings.BorderColor = clAlphaColor.clHexToColor('#FFFFFF');
  BtnTabTeklif.clProSettings.BorderColor = clAlphaColor.clHexToColor('#FFFFFF');
  BtnTabMusteri.clProSettings.BorderColor = clAlphaColor.clHexToColor('#FFFFFF');
  BtnTabGorevler.clProSettings.BorderColor = clAlphaColor.clHexToColor('#FFFFFF');
  BtnTabAnalizler.clProSettings.BorderColor = clAlphaColor.clHexToColor('#FFFFFF');

  if (Secim == 0)
  {
    BtnTabAll.clProSettings.FontColor = clAlphaColor.clHexToColor('#2563EB');
    BtnTabAll.clProSettings.BorderColor = clAlphaColor.clHexToColor('#2563EB');
    
    PnlDashboardView.Visible = True;
    PnlListView.Visible = False;
    
    GuncelleIstatistik;
  }
  else if (Secim == 1)
  {
    BtnTabFirsat.clProSettings.FontColor = clAlphaColor.clHexToColor('#2563EB');
    BtnTabFirsat.clProSettings.BorderColor = clAlphaColor.clHexToColor('#2563EB');
    
    PnlDashboardView.Visible = False;
    PnlListView.Visible = True;
    
    ActiveFilter = 1;
    
    BtnFAll.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F1F5F9');
    BtnFAll.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
    BtnFFirsat.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#2563EB');
    BtnFFirsat.clProSettings.FontColor = clAlphaColor.clWhite;
    BtnFTeklif.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F1F5F9');
    BtnFTeklif.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
    BtnFKazanilan.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F1F5F9');
    BtnFKazanilan.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
    
    BtnFAll.SetclProSettings(BtnFAll.clProSettings);
    BtnFFirsat.SetclProSettings(BtnFFirsat.clProSettings);
    BtnFTeklif.SetclProSettings(BtnFTeklif.clProSettings);
    BtnFKazanilan.SetclProSettings(BtnFKazanilan.clProSettings);
    
    ListeleMusteriler;
  }
  else if (Secim == 2)
  {
    BtnTabTeklif.clProSettings.FontColor = clAlphaColor.clHexToColor('#2563EB');
    BtnTabTeklif.clProSettings.BorderColor = clAlphaColor.clHexToColor('#2563EB');
    
    PnlDashboardView.Visible = False;
    PnlListView.Visible = True;
    
    ActiveFilter = 2;
    
    BtnFAll.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F1F5F9');
    BtnFAll.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
    BtnFFirsat.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F1F5F9');
    BtnFFirsat.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
    BtnFTeklif.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#2563EB');
    BtnFTeklif.clProSettings.FontColor = clAlphaColor.clWhite;
    BtnFKazanilan.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F1F5F9');
    BtnFKazanilan.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');

    BtnFAll.SetclProSettings(BtnFAll.clProSettings);
    BtnFFirsat.SetclProSettings(BtnFFirsat.clProSettings);
    BtnFTeklif.SetclProSettings(BtnFTeklif.clProSettings);
    BtnFKazanilan.SetclProSettings(BtnFKazanilan.clProSettings);

    ListeleMusteriler;
  }
  else if (Secim == 3)
  {
    BtnTabMusteri.clProSettings.FontColor = clAlphaColor.clHexToColor('#2563EB');
    BtnTabMusteri.clProSettings.BorderColor = clAlphaColor.clHexToColor('#2563EB');
    
    PnlDashboardView.Visible = False;
    PnlListView.Visible = True;
    
    ActiveFilter = 0;
    
    BtnFAll.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#2563EB');
    BtnFAll.clProSettings.FontColor = clAlphaColor.clWhite;
    BtnFFirsat.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F1F5F9');
    BtnFFirsat.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
    BtnFTeklif.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F1F5F9');
    BtnFTeklif.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
    BtnFKazanilan.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F1F5F9');
    BtnFKazanilan.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');

    BtnFAll.SetclProSettings(BtnFAll.clProSettings);
    BtnFFirsat.SetclProSettings(BtnFFirsat.clProSettings);
    BtnFTeklif.SetclProSettings(BtnFTeklif.clProSettings);
    BtnFKazanilan.SetclProSettings(BtnFKazanilan.clProSettings);

    ListeleMusteriler;
  }
  else if (Secim == 4)
  {
    ShowMessage('Görevler & Takvim modülü yakında hizmete açılacaktır.');
    TabGecisleri(0);
    Exit;
  }
  else if (Secim == 5)
  {
    ShowMessage('Analizler modülü yakında hizmete açılacaktır.');
    TabGecisleri(0);
    Exit;
  }

  BtnTabAll.SetclProSettings(BtnTabAll.clProSettings);
  BtnTabFirsat.SetclProSettings(BtnTabFirsat.clProSettings);
  BtnTabTeklif.SetclProSettings(BtnTabTeklif.clProSettings);
  BtnTabMusteri.SetclProSettings(BtnTabMusteri.clProSettings);
  BtnTabGorevler.SetclProSettings(BtnTabGorevler.clProSettings);
  BtnTabAnalizler.SetclProSettings(BtnTabAnalizler.clProSettings);
}

void OnTabAllClick; { TabGecisleri(0); }
void OnTabFirsatClick; { TabGecisleri(1); }
void OnTabTeklifClick; { TabGecisleri(2); }
void OnTabMusteriClick; { TabGecisleri(3); }
void OnTabGorevlerClick; { TabGecisleri(4); }
void OnTabAnalizlerClick; { TabGecisleri(5); }

void UpdateFilterUI(ActiveBtn: TclProButton);
{
  BtnFAll.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F1F5F9');
  BtnFAll.clProSettings.BorderColor = clAlphaColor.clHexToColor('#E2E8F0');
  BtnFAll.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
  BtnFAll.SetclProSettings(BtnFAll.clProSettings);

  BtnFFirsat.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F1F5F9');
  BtnFFirsat.clProSettings.BorderColor = clAlphaColor.clHexToColor('#E2E8F0');
  BtnFFirsat.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
  BtnFFirsat.SetclProSettings(BtnFFirsat.clProSettings);

  BtnFTeklif.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F1F5F9');
  BtnFTeklif.clProSettings.BorderColor = clAlphaColor.clHexToColor('#E2E8F0');
  BtnFTeklif.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
  BtnFTeklif.SetclProSettings(BtnFTeklif.clProSettings);

  BtnFKazanilan.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F1F5F9');
  BtnFKazanilan.clProSettings.BorderColor = clAlphaColor.clHexToColor('#E2E8F0');
  BtnFKazanilan.clProSettings.FontColor = clAlphaColor.clHexToColor('#475569');
  BtnFKazanilan.SetclProSettings(BtnFKazanilan.clProSettings);

  ActiveBtn.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#2563EB');
  ActiveBtn.clProSettings.BorderColor = clAlphaColor.clHexToColor('#2563EB');
  ActiveBtn.clProSettings.FontColor = clAlphaColor.clWhite;
  ActiveBtn.SetclProSettings(ActiveBtn.clProSettings);
}

void FiltreHepsi; { ActiveFilter = 0; UpdateFilterUI(BtnFAll); ListeleMusteriler; }
void FiltreFirsat; { ActiveFilter = 1; UpdateFilterUI(BtnFFirsat); ListeleMusteriler; }
void FiltreTeklif; { ActiveFilter = 2; UpdateFilterUI(BtnFTeklif); ListeleMusteriler; }
void FiltreKazanilan; { ActiveFilter = 3; UpdateFilterUI(BtnFKazanilan); ListeleMusteriler; }

void SetKpiCardStyle(APanel: TclProPanel);
{
  APanel.Align = alLeft;
  APanel.Width = 195;
  APanel.Height = 110;
  APanel.Margins.Right = 10;
  APanel.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#FFFFFF');
  APanel.clProSettings.BorderColor = clAlphaColor.clHexToColor('#E2E8F0');
  APanel.clProSettings.BorderWidth = 1;
  APanel.clProSettings.IsRound = True;
  APanel.clProSettings.RoundHeight = 12;
  APanel.clProSettings.RoundWidth = 12;
  APanel.clProSettings.IsFill = True;
  APanel.SetclProSettings(APanel.clProSettings);
}

void SetKpiLabelStyles(ALblTitle: TclProLabel; ALblVal: TclProLabel; ALblSub: TclProLabel; ATitleText, AValText, ASubText: String);
{
  ALblTitle.Align = alTop;
  ALblTitle.Height = 16;
  ALblTitle.Margins.Left = 12;
  ALblTitle.Margins.Top = 10;
  ALblTitle.Text = ATitleText;
  ALblTitle.clProSettings.FontSize = 9;
  ALblTitle.clProSettings.FontColor = clAlphaColor.clHexToColor('#64748B');
  ALblTitle.clProSettings.TextSettings.Font.Style = [fsBold];
  ALblTitle.SetclProSettings(ALblTitle.clProSettings);

  ALblVal.Align = alTop;
  ALblVal.Height = 28;
  ALblVal.Margins.Left = 12;
  ALblVal.Margins.Top = 4;
  ALblVal.Text = AValText;
  ALblVal.clProSettings.FontSize = 16;
  ALblVal.clProSettings.FontColor = clAlphaColor.clHexToColor('#0F172A');
  ALblVal.clProSettings.TextSettings.Font.Style = [fsBold];
  ALblVal.SetclProSettings(ALblVal.clProSettings);

  ALblSub.Align = alBottom;
  ALblSub.Height = 20;
  ALblSub.Margins.Left = 12;
  ALblSub.Margins.Bottom = 10;
  ALblSub.Text = ASubText;
  ALblSub.clProSettings.FontSize = 9;
  ALblSub.clProSettings.FontColor = clAlphaColor.clHexToColor('#94A3B8');
  ALblSub.SetclProSettings(ALblSub.clProSettings);
}

void SetKpiIconStyle(APanelBg: TclProPanel; ALblIcon: TclProLabel; AColorHex, AIconStr: String);
{
  APanelBg.Align = alTop;
  APanelBg.Width = 32;
  APanelBg.Height = 32;
  APanelBg.Margins.Top = 10;
  APanelBg.Margins.Right = 12;
  APanelBg.clProSettings.BackgroundColor = clAlphaColor.clHexToColor(AColorHex);
  APanelBg.clProSettings.IsRound = True;
  APanelBg.clProSettings.RoundHeight = 16;
  APanelBg.clProSettings.RoundWidth = 16;
  APanelBg.clProSettings.IsFill = True;
  APanelBg.SetclProSettings(APanelBg.clProSettings);

  ALblIcon.Align = alClient;
  ALblIcon.Text = AIconStr;
  ALblIcon.clProSettings.FontSize = 11;
  ALblIcon.clProSettings.FontHorzAlign = palCenter;
  ALblIcon.clProSettings.FontVertAlign = palCenter;
  ALblIcon.clProSettings.TextSettings.Font.Style = [fsBold];
  ALblIcon.SetclProSettings(ALblIcon.clProSettings);
}

void ResponsiveDuzenle;
var
  W: Single;
{
  W = AnaForm.clWidth;
  if (W <= 0) Exit;

  if (W < 500)
  {
    PnlSearchHeader.Visible = False;
    LblProfileName.Visible = False;
    PnlProfile.Width = 74;
    PnlHeaderTexts.Width = 90;
    
    PnlModalDialog.Width = W - 28;
    PnlModalDialog.Height = 480;
  }
  else
  {
    PnlSearchHeader.Visible = True;
    LblProfileName.Visible = True;
    PnlProfile.Width = 170;
    PnlHeaderTexts.Width = 140;
    
    PnlModalDialog.Width = 340;
    PnlModalDialog.Height = 500;
  }

  PnlCol1.Width = (W - 56) / 6;
  PnlCol2.Width = (W - 56) / 6;
  PnlCol3.Width = (W - 56) / 6;
  PnlCol4.Width = (W - 56) / 6;
  PnlCol5.Width = (W - 56) / 6;
  PnlCol6.Width = (W - 56) / 6;
}


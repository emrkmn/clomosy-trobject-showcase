var
  SatisForm: TclForm;
  MainScroll: TclVertScrollBox;
  UstPanel, SolPanel, SagPanel, fisPanel: TclProPanel;
  UrunListe: TclProListView;
  BarkodEdt: TclProEdit;
  MiktarEdt: TclEdit;
  ToplamLabel, FisLabel: TclProLabel;
  SatisBtn, UrunEkleBtn, TemizleBtn, GecmisBtn, BtnBarkodTara, GeriAlBtn: TclProButton;
  searchEdt: TclProSearchEdit;
  DPanl: TClProListViewDesignerPanel;
  UrunLbl, BarkodLbl, KategoriLbl, FiyatLbl, StokMiktarLbl: TClProLabel;
  SepetListesi: TclStringList;
  IsBusy: Boolean;
  IsWide: Boolean;
  Sc: Double;
  ScreenW: Integer;
  ScreenH: Integer;
  SolW: Integer;
  SolPhoneH: Integer;
  FisH: Integer;

void TablolariKontrolEtVeOlustur;
var
  TableExists: Boolean;
{
  try
    Clomosy.DBSQLiteConnect(Clomosy.AppFilesPath + 'StokTakip.db', '');

    Clomosy.DBSQLiteQuery.SQL.Text = 'SELECT name FROM sqlite_master WHERE type="table" AND name="StokTakip"';
    Clomosy.DBSQLiteQuery.OpenOrExecute;
    TableExists = not Clomosy.DBSQLiteQuery.Eof;

    if not (TableExists)
    {
      Clomosy.DBSQLiteQuery.SQL.Text = 'CREATE TABLE StokTakip (' +
        'UrunAdi TEXT NOT NULL, ' +
        'Barkod TEXT NOT NULL UNIQUE, ' +
        'Kategori TEXT NOT NULL, ' +
        'Fiyat TEXT NOT NULL, ' +
        'StokMiktari TEXT NOT NULL)';
      Clomosy.DBSQLiteQuery.OpenOrExecute;
    }

    Clomosy.DBSQLiteQuery.SQL.Text = 'SELECT name FROM sqlite_master WHERE type="table" AND name="SatisGecmisi"';
    Clomosy.DBSQLiteQuery.OpenOrExecute;
    TableExists = not Clomosy.DBSQLiteQuery.Eof;

    if not (TableExists)
    {
      Clomosy.DBSQLiteQuery.SQL.Text = 'CREATE TABLE SatisGecmisi (' +
        'SatisID INTEGER PRIMARY KEY AUTOINCREMENT, ' +
        'IslemNo TEXT, ' +
        'Tarih TEXT, ' +
        'Barkod TEXT, ' +
        'UrunAdi TEXT, ' +
        'Miktar INTEGER, ' +
        'Tutar TEXT)';
      Clomosy.DBSQLiteQuery.OpenOrExecute;
    }
  except
    ShowMessage('Tablo Olusturma Hatasi: ' + LastExceptionMessage);
  }
}

void CalcLayout;
{
  ScreenW = SatisForm.clWidth;
  ScreenH = SatisForm.clHeight;
  IsWide = ((ScreenW >= 600) && (ScreenH >= 700));

  if (IsWide)
  {
    Sc = 1;
    if (ScreenW >= 1000) { Sc = 1.1; }

    SolW = ScreenW * 0.32;
    if (SolW < 300) { SolW = 300; }
    if (SolW > 400) { SolW = 400; }
  }
  else
  {
    Sc = ScreenW / 390;
    if (Sc < 0.85) { Sc = 0.85; }
    if (Sc > 1.25) { Sc = 1.25; }
    SolW = ScreenW;
  }

  FisH = 180 * Sc;
  SolPhoneH = (435 * Sc) + FisH + 140;
  if (Clomosy.PlatformIsMobile)
  {
    SolPhoneH = SolPhoneH + (50 * Sc) + 15;
  }
}

void SetupEdit(AEdit: TclProEdit; APlaceHolder: String);
{
  AEdit.Align = alTop;
  AEdit.Height = 50 * Sc;
  AEdit.Margins.Top = 10;
  AEdit.Margins.Left = 15;
  AEdit.Margins.Right = 15;
  AEdit.TextPrompt = APlaceHolder;
  AEdit.clProSettings.FontSize = 14 * Sc;
  AEdit.clProSettings.BorderColor = clAlphaColor.clHexToColor('#CBD5E1');
  AEdit.clProSettings.BorderWidth = 1;
  AEdit.clProSettings.RoundWidth = 8;
  AEdit.clProSettings.RoundHeight = 8;
  AEdit.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F8FAFC');
  AEdit.SetclProSettings(AEdit.clProSettings);
}

void SetupBtn(ABtn: TclProButton; AColor: String; AHeight: Integer; AFont: Integer; ABottom: Boolean; AMargin: Integer);
{
  if (ABottom)
  {
    ABtn.Align = alBottom;
    ABtn.Margins.Bottom = AMargin;
  }
  else
  {
    ABtn.Align = alTop;
    ABtn.Margins.Top = AMargin;
  }
  ABtn.Height = AHeight * Sc;
  ABtn.Margins.Left = 15;
  ABtn.Margins.Right = 15;
  ABtn.clProSettings.BackgroundColor = clAlphaColor.clHexToColor(AColor);
  ABtn.clProSettings.FontColor = clAlphaColor.clWhite;
  ABtn.clProSettings.FontSize = AFont * Sc;
  ABtn.clProSettings.IsFill = True;
  ABtn.clProSettings.IsRound = True;
  ABtn.clProSettings.RoundWidth = 8;
  ABtn.clProSettings.RoundHeight = 8;
  ABtn.clProSettings.BorderWidth = 0;
  ABtn.clProSettings.TextSettings.Font.Style = [fsBold];
  ABtn.SetclProSettings(ABtn.clProSettings);
}

void SetupListLabel(ALbl: TclProLabel; AColor: String; AFont: Integer; ABold: Boolean);
{
  ALbl.Align = alLeft;
  ALbl.Margins.Left = 15;
  ALbl.Height = 25 * Sc;
  ALbl.clProSettings.AutoSize = True;
  ALbl.clProSettings.FontColor = clAlphaColor.clHexToColor(AColor);
  ALbl.clProSettings.FontSize = AFont * Sc;
  ALbl.clProSettings.FontHorzAlign = palLeading;
  ALbl.clProSettings.FontVertAlign = palCenter;
  if (ABold)
  {
    ALbl.clProSettings.TextSettings.Font.Style = [fsBold];
  }
  ALbl.SetclProSettings(ALbl.clProSettings);
}

void GecmiseGit;
{
  Clomosy.RunUnit('USatisGecmisi');
}

void AlanTemizle;
{
  IsBusy = True;
  BarkodEdt.Text = '';
  MiktarEdt.Text = '1';
  ToplamLabel.Text = 'Toplam: 0 TL';
  IsBusy = False;
}

void GetData;
var
  Qry: TclSQLiteQuery;
  SQLText: String;
{
  try
    SQLText = 'Select ''Urun Adi: ''||UrunAdi as UrunLbl, ''Barkod: ''||Barkod as BarkodLbl, ''Kategori: ''||Kategori as KategoriLbl, ''Fiyat: ''||Fiyat as FiyatLbl, ''Stok: ''||StokMiktari as StokMiktarLbl From StokTakip';

    if (searchEdt.Text <> '')
    {
      SQLText = SQLText + ' WHERE UrunAdi LIKE ' + QuotedStr('%' + searchEdt.Text + '%');
    }

    Qry = Clomosy.DBSQLiteQueryWith(SQLText);
    Qry.OpenOrExecute;

    if (Qry.Found)
    {
      UrunListe.ClLoadProListViewDataFromDataset(Qry);
    }
    else
    {
      UrunListe.ClearList;
    }
  except
    ShowMessage('Hata: ' + LastExceptionMessage);
  }
}

function StokGetir(ABarkod: String): Integer;
{
  Clomosy.DBSQLiteQuery.SQL.Text = 'Select StokMiktari From StokTakip Where Barkod = ' + QuotedStr(ABarkod);
  Clomosy.DBSQLiteQuery.OpenOrExecute;

  if (Clomosy.DBSQLiteQuery.Found)
  {
    Result = Round(StrToFloat(Clomosy.DBSQLiteQuery.FieldByName('StokMiktari').AsString));
  }
  else
  {
    Result = -1;
  }
}

function SepetMiktarGetir(ABarkod: String): Integer;
var
  i: Integer;
  Satir: String;
{
  Result = 0;
  for i = 0 to SepetListesi.Count - 1
  {
    Satir = Clomosy.StringListItemString(SepetListesi, i);
    if (clGetStringTo(Satir, ';') == ABarkod)
    {
      Result = StrToInt(clGetStringAfter(Satir, ';'));
    }
  }
}

void SepetKaydet(ABarkod: String; AMiktar: Integer);
var
  i: Integer;
  Satir: String;
  Yeni: TclStringList;
  Bulundu: Boolean;
{
  Yeni = Clomosy.StringListNew;
  Bulundu = False;

  for i = 0 to SepetListesi.Count - 1
  {
    Satir = Clomosy.StringListItemString(SepetListesi, i);
    if (clGetStringTo(Satir, ';') == ABarkod)
    {
      Yeni.Add(ABarkod + ';' + IntToStr(AMiktar));
      Bulundu = True;
    }
    else
    {
      Yeni.Add(Satir);
    }
  }

  if not (Bulundu)
  {
    Yeni.Add(ABarkod + ';' + IntToStr(AMiktar));
  }

  SepetListesi = Yeni;
}

void SepetYenile;
var
  i, Miktar: Integer;
  Satir, Barkod, Ad: String;
  Fiyat, Tutar, Toplam: Double;
  Gorunum: TclStringList;
{
  if (SepetListesi.Count == 0)
  {
    FisLabel.Text = 'Sepet Bos';
    Exit;
  }

  Gorunum = Clomosy.StringListNew;
  Toplam = 0;

  for i = 0 to SepetListesi.Count - 1
  {
    Satir = Clomosy.StringListItemString(SepetListesi, i);
    Barkod = clGetStringTo(Satir, ';');
    Miktar = StrToInt(clGetStringAfter(Satir, ';'));

    Clomosy.DBSQLiteQuery.SQL.Text = 'Select UrunAdi, Fiyat From StokTakip Where Barkod = ' + QuotedStr(Barkod);
    Clomosy.DBSQLiteQuery.OpenOrExecute;

    if (Clomosy.DBSQLiteQuery.Found)
    {
      Ad = Clomosy.DBSQLiteQuery.FieldByName('UrunAdi').AsString;
      Fiyat = StrToFloat(Clomosy.DBSQLiteQuery.FieldByName('Fiyat').AsString);
      Tutar = Fiyat * Miktar;
      Toplam = Toplam + Tutar;
      Gorunum.Add(IntToStr(i + 1) + '. ' + Ad + ' x' + IntToStr(Miktar) + ' = ' + FormatFloat('#,##0.00', Tutar) + ' TL');
    }
  }

  Gorunum.Add('------------------');
  Gorunum.Add('TOPLAM: ' + FormatFloat('#,##0.00', Toplam) + ' TL');
  FisLabel.Text = Gorunum.Text;
}

void ToplamHesapla;
var
  Fiyat: Double;
  Miktar: Integer;
{
  if ((BarkodEdt.Text <> '') && (MiktarEdt.Text <> ''))
  {
    try
      Clomosy.DBSQLiteQuery.SQL.Text = 'Select Fiyat From StokTakip Where Barkod = ' + QuotedStr(BarkodEdt.Text);
      Clomosy.DBSQLiteQuery.OpenOrExecute;

      if (Clomosy.DBSQLiteQuery.Found)
      {
        Fiyat = StrToFloat(Clomosy.DBSQLiteQuery.FieldByName('Fiyat').AsString);
        Miktar = Round(StrToFloat(MiktarEdt.Text));
        ToplamLabel.Text = 'Toplam: ' + FormatFloat('#,##0.00', Fiyat * Miktar) + ' TL';
      }
      else
      {
        ToplamLabel.Text = 'Toplam: 0 TL';
      }
    except
      ToplamLabel.Text = 'Toplam: 0 TL';
    }
  }
  else
  {
    ToplamLabel.Text = 'Toplam: 0 TL';
  }
}

void onItemClicked;
{
  try
    BarkodEdt.Text = clGetStringAfter(UrunListe.clSelectedItemData(clText), ': ');
  except
    ShowMessage('Liste secim hatasi: ' + LastExceptionMessage);
  }
}

void UrunEkle;
var
  Barkod: String;
  Miktar, Stok, Mevcut: Integer;
{
  if ((BarkodEdt.Text == '') || (MiktarEdt.Text == ''))
  {
    Exit;
  }

  Barkod = BarkodEdt.Text;

  try
    Miktar = Round(StrToFloat(MiktarEdt.Text));
  except
    ShowMessage('Gecersiz miktar!');
    Exit;
  }

  if (Miktar <= 0)
  {
    ShowMessage('Miktar 0''dan buyuk olmali!');
    Exit;
  }

  Stok = StokGetir(Barkod);

  if (Stok < 0)
  {
    ShowMessage('Urun bulunamadi! Lutfen once stok ekleyiniz.');
    AlanTemizle;
    Exit;
  }

  Mevcut = SepetMiktarGetir(Barkod);

  if ((Mevcut + Miktar) > Stok)
  {
    ShowMessage('Yetersiz stok! Stokta ' + IntToStr(Stok) + ' adet var, sepette ' + IntToStr(Mevcut) + ' adet var.');
    AlanTemizle;
    Exit;
  }

  SepetKaydet(Barkod, Mevcut + Miktar);
  SepetYenile;
  AlanTemizle;
  BarkodEdt.SetFocus;
}

void BarkodTara;
{
  if (Clomosy.PlatformIsMobile)
  {
    SatisForm.CallBarcodeReader(BarkodEdt);
  }
}

void OtomatikEkle;
{
  if (IsBusy)
  {
    Exit;
  }

  if (BarkodEdt.Text == '')
  {
    ToplamLabel.Text = 'Toplam: 0 TL';
    Exit;
  }

  if (StokGetir(BarkodEdt.Text) >= 0)
  {
    if (MiktarEdt.Text == '')
    {
      MiktarEdt.Text = '1';
    }
    UrunEkle;
  }
  else
  {
    ToplamLabel.Text = 'Toplam: 0 TL';
  }
}

void SatisYap;
var
  i, Miktar, MevcutStok, Stok: Integer;
  Satir, Barkod, UrunAdi, IslemNo: String;
  Fiyat, Tutar: Double;
{
  if (SepetListesi.Count == 0)
  {
    ShowMessage('Sepet bos!');
    Exit;
  }

  try
    for i = 0 to SepetListesi.Count - 1
    {
      Satir = Clomosy.StringListItemString(SepetListesi, i);
      Barkod = clGetStringTo(Satir, ';');
      Miktar = StrToInt(clGetStringAfter(Satir, ';'));
      Stok = StokGetir(Barkod);

      if (Stok < Miktar)
      {
        ShowMessage('Yetersiz stok! Barkod: ' + Barkod + ' / Stok: ' + IntToStr(Stok));
        Exit;
      }
    }

    IslemNo = FormatDateTime('yyyymmddhhnnss', Now) + '_' + IntToStr(clMath.GenerateRandom(100, 999));

    for i = 0 to SepetListesi.Count - 1
    {
      Satir = Clomosy.StringListItemString(SepetListesi, i);
      Barkod = clGetStringTo(Satir, ';');
      Miktar = StrToInt(clGetStringAfter(Satir, ';'));

      Clomosy.DBSQLiteQuery.SQL.Text = 'Select UrunAdi, Fiyat, StokMiktari From StokTakip Where Barkod = ' + QuotedStr(Barkod);
      Clomosy.DBSQLiteQuery.OpenOrExecute;

      if (Clomosy.DBSQLiteQuery.Found)
      {
        UrunAdi = Clomosy.DBSQLiteQuery.FieldByName('UrunAdi').AsString;
        Fiyat = StrToFloat(Clomosy.DBSQLiteQuery.FieldByName('Fiyat').AsString);
        MevcutStok = Round(StrToFloat(Clomosy.DBSQLiteQuery.FieldByName('StokMiktari').AsString));
        Tutar = Fiyat * Miktar;

        Clomosy.DBSQLiteQuery.SQL.Text = 'Update StokTakip Set StokMiktari = ' +
          IntToStr(MevcutStok - Miktar) +
          ' Where Barkod = ' + QuotedStr(Barkod);
        Clomosy.DBSQLiteQuery.OpenOrExecute;

        Clomosy.DBSQLiteQuery.SQL.Text = 'INSERT INTO SatisGecmisi (IslemNo, Tarih, Barkod, UrunAdi, Miktar, Tutar) VALUES (' +
          QuotedStr(IslemNo) + ', ' +
          QuotedStr(DateTimeToStr(Now)) + ', ' +
          QuotedStr(Barkod) + ', ' +
          QuotedStr(UrunAdi) + ', ' +
          IntToStr(Miktar) + ', ' +
          QuotedStr(FormatFloat('#,##0.00', Tutar)) + ')';
        Clomosy.DBSQLiteQuery.OpenOrExecute;
      }
    }

    ShowMessage('Satis tamamlandi, gecmise yonlendiriliyorsunuz...');
    SepetListesi = Clomosy.StringListNew;
    SepetYenile;
    AlanTemizle;
    GetData;

    Clomosy.RunUnit('USatisGecmisi');
  except
    ShowMessage('Hata: ' + LastExceptionMessage);
  }
}

void FisTemizle;
{
  SepetListesi = Clomosy.StringListNew;
  SepetYenile;
  AlanTemizle;
}

void SonUrunuCikar;
var
  i: Integer;
  Yeni: TclStringList;
{
  if (SepetListesi.Count == 0)
  {
    Exit;
  }

  Yeni = Clomosy.StringListNew;
  for i = 0 to SepetListesi.Count - 2
  {
    Yeni.Add(Clomosy.StringListItemString(SepetListesi, i));
  }

  SepetListesi = Yeni;
  SepetYenile;
}

{
  SatisForm = TclForm.Create(Self);

  SagPanel.clProSettings.BorderColor = clAlphaColor.clHexToColor('#E2E8F0');
  SagPanel.clProSettings.BorderWidth = 1;
  SagPanel.SetclProSettings(SagPanel.clProSettings);

  UrunListe = SatisForm.AddNewProListView(SagPanel, 'UrunListe');
  UrunListe.Align = alClient;
  UrunListe.Margins.Top = 10;
  UrunListe.Margins.Left = 10;
  UrunListe.Margins.Right = 10;
  UrunListe.Margins.Bottom = 10;

  DPanl = SatisForm.AddNewProListViewDesignerPanel(UrunListe, 'DPanl');
  DPanl.Align = alTop;
  DPanl.Height = 120 * Sc;
  DPanl.clProSettings.IsRound = True;
  DPanl.clProSettings.IsFill = True;
  DPanl.clProSettings.ItemHeight = 130 * Sc;
  DPanl.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F8FAFC');
  DPanl.clProSettings.BorderColor = clAlphaColor.clHexToColor('#CBD5E1');
  DPanl.clProSettings.BorderWidth = 1;
  DPanl.clProSettings.RoundWidth = 10;
  DPanl.clProSettings.RoundHeight = 10;
  DPanl.SetclProSettings(DPanl.clProSettings);
  UrunListe.SetDesignerPanel(DPanl);

  UrunLbl = SatisForm.AddNewProLabel(DPanl, 'UrunLbl', '-');
  SetupListLabel(UrunLbl, '#1E293B', 16, True);
  UrunLbl.Margins.Top = 5;
  UrunLbl.Height = 30 * Sc;
  DPanl.AddPanelObject(UrunLbl, clText4);

  FiyatLbl = SatisForm.AddNewProLabel(DPanl, 'FiyatLbl', '-');
  SetupListLabel(FiyatLbl, '#10B981', 14, True);
  FiyatLbl.Width = 100 * Sc;
  FiyatLbl.Margins.Right = 15;
  DPanl.AddPanelObject(FiyatLbl, clText2);

  BarkodLbl = SatisForm.AddNewProLabel(DPanl, 'BarkodLbl', '-');
  SetupListLabel(BarkodLbl, '#64748B', 13, False);
  DPanl.AddPanelObject(BarkodLbl, clText);

  KategoriLbl = SatisForm.AddNewProLabel(DPanl, 'KategoriLbl', '-');
  SetupListLabel(KategoriLbl, '#64748B', 13, False);
  DPanl.AddPanelObject(KategoriLbl, clText1);

  StokMiktarLbl = SatisForm.AddNewProLabel(DPanl, 'StokMiktarLbl', '-');
  SetupListLabel(StokMiktarLbl, '#3B82F6', 13, True);
  StokMiktarLbl.Margins.Bottom = 5;
  DPanl.AddPanelObject(StokMiktarLbl, clText3);

  SatisForm.AddNewEvent(UrunListe, tbeOnItemClick, 'onItemClicked');
  SatisForm.AddNewEvent(MiktarEdt, tbeOnChange, 'ToplamHesapla');
  SatisForm.AddNewEvent(SatisBtn, tbeOnClick, 'SatisYap');
  SatisForm.AddNewEvent(UrunEkleBtn, tbeOnClick, 'UrunEkle');
  SatisForm.AddNewEvent(TemizleBtn, tbeOnClick, 'FisTemizle');
  SatisForm.AddNewEvent(GeriAlBtn, tbeOnClick, 'SonUrunuCikar');
  SatisForm.AddNewEvent(searchEdt, tbeOnKeyUp, 'GetData');

  GetData;
  SatisForm.Run;
}

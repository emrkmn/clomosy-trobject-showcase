var
  MyForm: TclForm;
  MainScroll: TclVertScrollBox;   // sadece telefon modunda kullanilir
  FormScroll: TclVertScrollBox;   // sadece genis ekran modunda sol panelin icinde
  UstPanel, SolPanel, SagPanel: TclProPanel;
  PListView: TclProListView;
  UrunAdiEdt, BarkodEdt, KategoriEdt, FiyatEdt, StokMiktariEdt: TclProEdit;
  searchEdt: TclProSearchEdit;
  KaydetBtn, GuncelleBtn, SilBtn, SatisBtn: TclProButton;
  DPanl: TClProListViewDesignerPanel;
  UrunLbl, BarkodLbl, KategoriLbl, FiyatLbl, StokMiktarLbl: TClProLabel;
  ButtonPanel: TclProPanel;

  // yardimci (gecici) nesneler
  TmpEdt: TclProEdit;
  TmpBtn: TclProButton;

  // RESPONSIVE degiskenleri
  IsWide: Boolean;     // True: yan yana (tablet/yatay), False: alt alta (telefon)
  Sc: Double;          // olcek carpani
  ScreenW: Integer;
  ScreenH: Integer;
  SolW: Integer;       // genis modda sol panel genisligi
  BtnPanelH: Integer;  // buton panelinin yuksekligi
  PhoneFormH: Integer; // telefon modunda form panelinin yuksekligi

void SatiseGit;
{
  Clomosy.RunUnit('USatis');
}

void ClearEdtText;
{
  UrunAdiEdt.Text = '';
  BarkodEdt.Text = '';
  KategoriEdt.Text = '';
  FiyatEdt.Text = '';
  StokMiktariEdt.Text = '';
}

void GetData;
var
  Qry: TclSQLiteQuery;
  SQLText: String;
{
  try
    SQLText = 'Select ''Urun Adi: ''||UrunAdi as UrunLbl, ''Barkod: ''||Barkod as BarkodLbl, ''Kategori: ''||Kategori as KategoriLbl, ''Fiyat: ''||Fiyat as FiyatLbl, ''Stok: ''||StokMiktari as StokMiktarLbl From StokTakip';

    if (searchEdt.Text <> '')
    {
      SQLText = SQLText + ' WHERE UrunAdi LIKE ' + QuotedStr('%' + searchEdt.Text + '%');
    }

    Qry = Clomosy.DBSQLiteQueryWith(SQLText);
    Qry.OpenOrExecute;

    if (Qry.Found)
    {
      PListView.ClLoadProListViewDataFromDataset(Qry);
    }
    else
    {
      PListView.ClearList;
    }

  except
    ShowMessage('Hata: ' + LastExceptionMessage);
  }
}

function Sorgula: Boolean;
{
  if (BarkodEdt.Text == '')
  {
    ShowMessage('Barkod bos olamaz!');
    Result = False;
    Exit;
  }

  Clomosy.DBSQLiteQuery.SQL.Text = 'Select * From StokTakip Where Barkod = ' + QuotedStr(BarkodEdt.Text);
  Clomosy.DBSQLiteQuery.OpenOrExecute;

  Result = not Clomosy.DBSQLiteQuery.Found;
}

void DataInsert;
{
  if ((UrunAdiEdt.Text == '') || (BarkodEdt.Text == '') || (KategoriEdt.Text == '') || (FiyatEdt.Text == '') || (StokMiktariEdt.Text == ''))
  {
    ShowMessage('Zorunlu Alanlari Doldurun.');
  }
  else
  {
    try
      if (Sorgula)
      {
        Clomosy.DBSQLiteQuery.SQL.Text = 'INSERT INTO StokTakip(UrunAdi, Barkod, Kategori, Fiyat, StokMiktari) VALUES (' +
          QuotedStr(UrunAdiEdt.Text) + ',' +
          QuotedStr(BarkodEdt.Text) + ',' +
          QuotedStr(KategoriEdt.Text) + ',' +
          QuotedStr(FiyatEdt.Text) + ',' +
          QuotedStr(StokMiktariEdt.Text) + ')';
        Clomosy.DBSQLiteQuery.OpenOrExecute;
        GetData;
        ClearEdtText;
        ShowMessage('Urun Eklendi.');
      }
      else
      {
        ShowMessage('Bu barkod zaten kayitli!');
      }
    except
      ShowMessage('Hata: ' + LastExceptionMessage);
    }
  }
}

void onItemClicked;
{
  try
    UrunAdiEdt.Text = clGetStringAfter(PListView.clSelectedItemData(clText4), ': ');
    BarkodEdt.Text = clGetStringAfter(PListView.clSelectedItemData(clText), ': ');
    KategoriEdt.Text = clGetStringAfter(PListView.clSelectedItemData(clText1), ': ');
    FiyatEdt.Text = clGetStringAfter(PListView.clSelectedItemData(clText2), ': ');
    StokMiktariEdt.Text = clGetStringAfter(PListView.clSelectedItemData(clText3), ': ');
  except
    ShowMessage('Secim hatasi.');
  }
}

void DataDelete;
{
  try
    if (BarkodEdt.Text <> '')
    {
      Clomosy.DBSQLiteQuery.SQL.Text = 'Delete From StokTakip where Barkod = ' + QuotedStr(BarkodEdt.Text);
      Clomosy.DBSQLiteQuery.OpenOrExecute;
      GetData;
      ClearEdtText;
      ShowMessage('Urun Silindi.');
    }
    else
    {
      ShowMessage('Silinecek urun secilmedi!');
    }
  except
    ShowMessage('Hata: ' + LastExceptionMessage);
  }
}

void DataUpdate;
{
  if ((UrunAdiEdt.Text == '') || (BarkodEdt.Text == '') || (KategoriEdt.Text == '') || (FiyatEdt.Text == '') || (StokMiktariEdt.Text == ''))
  {
    ShowMessage('Guncellenecek urun secilmedi!');
  }
  else
  {
    try
      Clomosy.DBSQLiteQuery.SQL.Text = 'Update StokTakip Set UrunAdi = ' + QuotedStr(UrunAdiEdt.Text) +
        ', Kategori = ' + QuotedStr(KategoriEdt.Text) +
        ', Fiyat = ' + QuotedStr(FiyatEdt.Text) +
        ', StokMiktari = ' + QuotedStr(StokMiktariEdt.Text) +
        ' Where Barkod = ' + QuotedStr(BarkodEdt.Text);
      Clomosy.DBSQLiteQuery.OpenOrExecute;
      GetData;
      ClearEdtText;
      ShowMessage('Urun Guncellendi');
    except
      ShowMessage('Hata: ' + LastExceptionMessage);
    }
  }
}

void SqLiteConnectionCreateTable;
var
  TableExists: Boolean;
{
  try
    Clomosy.DBSQLiteConnect(Clomosy.appfilespath + 'StokTakip.db', '');

    Clomosy.DBSQLiteQuery.SQL.Text = 'SELECT name FROM sqlite_master WHERE type="table" AND name="StokTakip"';
    Clomosy.DBSQLiteQuery.OpenOrExecute;
    TableExists = not Clomosy.DBSQLiteQuery.Eof;

    if not (TableExists)
    {
      Clomosy.DBSQLiteQuery.SQL.Text = 'CREATE TABLE StokTakip (' +
        'UrunAdi TEXT NOT NULL, ' +
        'Barkod TEXT NOT NULL UNIQUE, ' +
        'Kategori TEXT NOT NULL, ' +
        'Fiyat TEXT NOT NULL, ' +
        'StokMiktari TEXT NOT NULL)';
      Clomosy.DBSQLiteQuery.OpenOrExecute;
    }

    Clomosy.DBSQLiteQuery.SQL.Text = 'SELECT name FROM sqlite_master WHERE type="table" AND name="SatisGecmisi"';
    Clomosy.DBSQLiteQuery.OpenOrExecute;
    TableExists = not Clomosy.DBSQLiteQuery.Eof;

    if not (TableExists)
    {
      Clomosy.DBSQLiteQuery.SQL.Text = 'CREATE TABLE SatisGecmisi (' +
        'SatisID INTEGER PRIMARY KEY AUTOINCREMENT, ' +
        'IslemNo TEXT, ' +
        'Tarih TEXT, ' +
        'Barkod TEXT, ' +
        'UrunAdi TEXT, ' +
        'Miktar INTEGER, ' +
        'Tutar TEXT)';
      Clomosy.DBSQLiteQuery.OpenOrExecute;
    }

  except
    ShowMessage('Baglanti Hatasi: ' + LastExceptionMessage);
  }
}

// ---------------------------------------------------------------
// RESPONSIVE YARDIMCILAR
// ---------------------------------------------------------------

// Ekran olcusune gore mod (yan yana / alt alta) ve olcek carpanini belirler
void CalcLayout;
{
  ScreenW = MyForm.clWidth;
  ScreenH = MyForm.clHeight;
  IsWide = (ScreenW >= 600);

  if (IsWide)
  {
    Sc = 1;
    if (ScreenH < 500) { Sc = 0.85; }    // yatay telefon
    if (ScreenW >= 1000) { Sc = 1.1; }   // genis tablet / masaustu

    // Sol panel: ekranin %35'i, 300 ile 420 arasi
    SolW = ScreenW * 0.35;
    if (SolW < 300) { SolW = 300; }
    if (SolW > 420) { SolW = 420; }
  }
  else
  {
    Sc = ScreenW / 390;
    if (Sc < 0.85) { Sc = 0.85; }
    if (Sc > 1.25) { Sc = 1.25; }
    SolW = ScreenW;
  }

  // 3 buton (45 + 8 margin) + Satisa Git butonu (50) + ic bosluk
  BtnPanelH = (3 * (45 * Sc + 8)) + (50 * Sc) + 20;

  // Telefon modunda form paneli: 5 edit + buton paneli + bosluklar
  PhoneFormH = (5 * (50 * Sc + 10)) + BtnPanelH + 50;
}

// Form alani (edit) olusturur; sonucu TmpEdt'e koyar
void AddEdit(EdtName: String; Prompt: String; TopMargin: Integer);
{
  if (IsWide)
  {
    TmpEdt = MyForm.AddNewProEdit(FormScroll, EdtName, '');
  }
  else
  {
    TmpEdt = MyForm.AddNewProEdit(SolPanel, EdtName, '');
  }
  TmpEdt.Align = alTop;
  TmpEdt.Height = 50 * Sc;
  TmpEdt.Margins.Top = TopMargin;
  TmpEdt.Margins.Left = 15;
  TmpEdt.Margins.Right = 15;
  TmpEdt.TextPrompt = Prompt;
  TmpEdt.clProSettings.FontSize = 14 * Sc;
  TmpEdt.clProSettings.BorderColor = clAlphaColor.clHexToColor('#CBD5E1');
  TmpEdt.clProSettings.BorderWidth = 1;
  TmpEdt.clProSettings.RoundWidth = 8;
  TmpEdt.clProSettings.RoundHeight = 8;
  TmpEdt.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#F8FAFC');
  TmpEdt.SetclProSettings(TmpEdt.clProSettings);
}

// Buton olusturur (ButtonPanel icinde); sonucu TmpBtn'e koyar
void AddBtn(BtnName: String; Caption: String; ColorHex: String; IsBottom: Boolean);
{
  TmpBtn = MyForm.AddNewProButton(ButtonPanel, BtnName, Caption);
  if (IsBottom)
  {
    TmpBtn.Align = alBottom;
    TmpBtn.Height = 50 * Sc;
  }
  else
  {
    TmpBtn.Align = alTop;
    TmpBtn.Height = 45 * Sc;
    TmpBtn.Margins.Bottom = 8;
  }
  TmpBtn.clProSettings.BackgroundColor = clAlphaColor.clHexToColor(ColorHex);
  TmpBtn.clProSettings.FontColor = clAlphaColor.clWhite;
  TmpBtn.clProSettings.FontSize = 14 * Sc;
  TmpBtn.clProSettings.IsFill = True;
  TmpBtn.clProSettings.IsRound = True;
  TmpBtn.clProSettings.RoundWidth = 8;
  TmpBtn.clProSettings.RoundHeight = 8;
  TmpBtn.clProSettings.BorderWidth = 0;
  TmpBtn.clProSettings.TextSettings.Font.Style = [fsBold];
  TmpBtn.SetclProSettings(TmpBtn.clProSettings);
}

{
  MyForm = TclForm.Create(Self);
  MyForm.clSetCaption('Depo');
  MyForm.SetFormColor('#F8FAFC', '#F8FAFC', clGNone);

  // Her seyden once ekran olcusunu hesapla
  CalcLayout;

  // ---------------- UST PANEL + ARAMA ----------------
  UstPanel = MyForm.AddNewProPanel(MyForm, 'UstPanel');
  UstPanel.Align = alTop;
  UstPanel.Height = 70 * Sc;
  UstPanel.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#3B82F6');
  UstPanel.clProSettings.IsFill = True;
  UstPanel.SetclProSettings(UstPanel.clProSettings);

  searchEdt = MyForm.AddNewProSearchEdit(UstPanel, 'searchEdt', 'Urun Adi Ile Arama Yap...');
  if (IsWide)
  {
    searchEdt.Align = alCenter;
    searchEdt.Width = 400;
  }
  else
  {
    // Telefonda sabit 400 genislik tasar; tum genisligi kaplasin
    searchEdt.Align = alClient;
    searchEdt.Margins.Left = 15;
    searchEdt.Margins.Right = 15;
  }
  searchEdt.Margins.Top = 15 * Sc;
  searchEdt.Margins.Bottom = 15 * Sc;
  searchEdt.clProSettings.FontSize = 14 * Sc;
  searchEdt.clProSettings.RoundWidth = 10;
  searchEdt.clProSettings.RoundHeight = 10;
  searchEdt.clProSettings.BackgroundColor = clAlphaColor.clWhite;
  searchEdt.SetclProSettings(searchEdt.clProSettings);

  // ---------------- ANA KAPSAYICI ----------------
  // Telefon modunda tum sayfa kayar (form + liste alt alta)
  if not (IsWide)
  {
    MainScroll = MyForm.AddNewVertScrollBox(MyForm, 'MainScroll');
    MainScroll.Align = alClient;
  }

  // ---------------- SOL / FORM PANELI ----------------
  if (IsWide)
  {
    SolPanel = MyForm.AddNewProPanel(MyForm, 'SolPanel');
    SolPanel.Align = alLeft;
    SolPanel.Width = SolW;
    SolPanel.Margins.Top = 10;
    SolPanel.Margins.Left = 10;
    SolPanel.Margins.Bottom = 10;
  }
  else
  {
    SolPanel = MyForm.AddNewProPanel(MainScroll, 'SolPanel');
    SolPanel.Align = alTop;

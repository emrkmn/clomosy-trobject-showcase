  MyForm.AddNewEvent(SatisBtn, tbeOnClick, 'SatiseGit');

  // ---------------- SAG / LISTE PANELI ----------------
  if (IsWide)
  {
    SagPanel = MyForm.AddNewProPanel(MyForm, 'SagPanel');
